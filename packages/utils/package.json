{
  "name": "@memoized-dom/utils",
  "version": "0.0.1",
  "description": "Optional utilities for memoized-dom applications",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/src/index.ts"
    }
  },
  "memoized-dom": {
    "source": true
  },
  "scripts": {
    "build": "node ../vite/dist/cli.js package",
    "test": "bun test --isolate ./tests && bun check -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@memoized-dom/data": "workspace:*"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
