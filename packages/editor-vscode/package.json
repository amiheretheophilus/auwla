{
  "name": "memoized-dom-auwla",
  "displayName": "Auwla (Prototype)",
  "description": "A thin VS Code adapter for the shared Auwla authoring tools.",
  "version": "0.0.9",
  "publisher": "amiheretheophilus",
  "private": true,
  "engines": { "vscode": "^1.126.0" },
  "categories": ["Programming Languages"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": false
  },
  "activationEvents": ["onLanguage:auwla"],
  "main": "./dist/extension.cjs",
  "contributes": {
    "configuration": {
      "title": "Auwla",
      "properties": {
        "auwla.reactivityHints": {
          "type": "boolean",
          "default": true,
          "description": "Show what each binding is beside its declaration, like an inferred type: state, derived ← its inputs, or source. Hover the name for what it means. Colors: auwla.reactivityHint.foreground and auwla.reactivityHint.background."
        }
      }
    },
    "colors": [
      {
        "id": "auwla.reactivityHint.foreground",
        "description": "Text of a reactivity hint (`: state`, `: derived ← count`) beside a declaration in an .auwla file.",
        "defaults": { "dark": "#E2C08D", "light": "#8A5A00", "highContrast": "#FFD580", "highContrastLight": "#5C3D00" }
      },
      {
        "id": "auwla.reactivityHint.background",
        "description": "Background behind a reactivity hint in an .auwla file.",
        "defaults": { "dark": "#E2C08D1A", "light": "#8A5A0012", "highContrast": "#00000000", "highContrastLight": "#00000000" }
      }
    ],
    "languages": [{
      "id": "auwla",
      "aliases": ["Auwla", "auwla"],
      "extensions": [".auwla"],
      "configuration": "./dist/language-configuration.json"
    }],
    "grammars": [{
      "language": "auwla",
      "scopeName": "source.auwla",
      "embeddedLanguages": {
        "meta.embedded.expression.auwla": "typescript",
        "meta.embedded.block.css": "css"
      },
      "path": "./dist/auwla.tmLanguage.json"
    }]
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun check",
    "test": "bun test"
  },
  "dependencies": { "@memoized-dom/jsx-plus": "workspace:*" },
  "devDependencies": { "@types/vscode": "1.100.0", "typescript": "7.1.0-beta", "vscode-textmate": "9.3.2" }
}
