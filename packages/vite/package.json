{
  "name": "@memoized-dom/vite",
  "version": "0.0.9",
  "description": "Vite 8 adapter for connected memoized-dom module graphs",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "memoized-dom": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun run ./scripts/clean.ts && rolldown -c rolldown.config.ts && tsc -p tsconfig.build.json",
    "test": "bun test --isolate ./tests",
    "bench": "bun run ./bench/run.ts"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@memoized-dom/adapters": "workspace:*",
    "@memoized-dom/compiler": "workspace:*",
    "@memoized-dom/devtools": "workspace:*",
    "@memoized-dom/server": "workspace:*",
    "magic-string": "0.30.21",
    "yuku-analyzer": "0.19.0",
    "yuku-ast": "0.19.0",
    "yuku-codegen": "0.19.0",
    "yuku-parser": "0.19.0"
  },
  "devDependencies": {
    "@memoized-dom/compiler-next": "workspace:*"
  },
  "peerDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@memoized-dom/runtime": "workspace:*",
    "typescript": ">=5.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": { "optional": true },
    "@cloudflare/vite-plugin": { "optional": true }
  },
  "publishConfig": {
    "access": "public"
  }
}
