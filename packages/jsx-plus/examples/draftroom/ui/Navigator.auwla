import type { Editor } from '../editor';
import type { EditorView } from '../model/types';
import { Icon } from './Icon.auwla';
import { Layers } from './Layers.auwla';

export function Navigator({ view, editor }: { view: EditorView; editor: Editor }) {
  return (
    <aside class="navigator" aria-label="Pages and layers">
      <section class="pages-section">
        <div class="section-heading">
          <h2>"Pages"</h2>
          <button type="button" class="icon-button small" title="New blank page" aria-label="New blank page"
            onClick={() => editor.project.add()}><Icon name="plus" /></button>
        </div>
        <nav class="page-list" aria-label="Pages">
          for (const page of view.pages) {
            <button key={page.id} type="button" class="page-row" aria-pressed={page.id === view.page.id}
              onClick={() => editor.project.open(page.id)}>
              <Icon name="file" /> <span class="truncate">page.name</span>
            </button>
          }
        </nav>
        <details class="templates">
          <summary><Icon name="layers" /> "New from template" <Icon name="chevron" /></summary>
          <button type="button" onClick={() => editor.project.add('workflow')}>"Product workflow"</button>
          <button type="button" onClick={() => editor.project.add('brainstorm')}>"Brainstorm"</button>
        </details>
      </section>
      <Layers shapes={view.page.shapes} selectedId={view.selected?.id} editor={editor} />
      <div class="navigator-footer"><span class="local-dot"></span> "Browser storage"</div>
    </aside>
  );
}
