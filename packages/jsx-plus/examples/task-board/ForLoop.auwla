import type {} from '@memoized-dom/compiler/jsx';

type Task = {
  id: number;
  title: string;
  done: boolean;
};

export function App() {
  let tasks: Task[] = [
    { id: 1, title: 'Build rows with ordinary JavaScript', done: false },
    { id: 2, title: 'Try the loop callbacks', done: false },
  ];
  let nextId = 3;
  let showOpen = false;

  const visible = tasks.filter(task => !showOpen || !task.done);
  const remaining = tasks.filter(task => !task.done).length;

  function addTask() {
    tasks = [...tasks, { id: nextId, title: `Task ${nextId}`, done: false }];
    nextId++;
  }

  function removeTask(id: number) {
    tasks = tasks.filter(task => task.id !== id);
  }

  // This is an ordinary host-language loop before the surrounding markup.
  // Its JSX values are collected explicitly, then rendered as an array child.
  const rows: JSX.Element[] = [];
  for (const task of visible) {
    rows.push(
      <li data-task-id=(task.id)>
        <button
          type="button"
          class="task-toggle"
          aria-pressed=(task.done)
          onClick=(() => task.done = !task.done)
        >
          <span class="task-status">task.done ? "Done" : "Open"</span>
          <span>task.title</span>
        </button>
        <button
          type="button"
          class="remove"
          aria-label=("Remove " + task.title)
          onClick=(() => removeTask(task.id))
        >
          "Remove"
        </button>
      </li>
    );
  }

  return (
    <main class="task-board">
      <header>
        <p class="eyebrow">"Auwla authoring example"</p>
        <h1>"Task rows with a for loop."</h1>
        <p>"Build the rows in JavaScript, then render the array below."</p>
      </header>
      <div class="add-task">
        <button type="button" class="add" onClick=(addTask)>"Add task"</button>
        <button type="button" class="filter-open" onClick=(() => showOpen = !showOpen)>
          showOpen ? "Show all" : "Show open"
        </button>
      </div>
      <p class="summary">`${remaining} ${remaining === 1 ? 'task' : 'tasks'} left`</p>
      <ul class="tasks">rows</ul>
      if (visible.length === 0) {
        <p class="empty" role="status">"No open tasks."</p>
      }
      <footer>`Showing ${visible.length} of ${tasks.length} tasks.`</footer>
    </main>
  );
}
