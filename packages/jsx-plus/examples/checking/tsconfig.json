{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "types": ["@memoized-dom/jsx-plus/types"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "paths": {
      "@memoized-dom/compiler/jsx": ["../../../compiler/src/jsx-types.ts"]
    }
  },
  "contentMappers": [
    { "package": "@memoized-dom/jsx-plus", "extensions": [".auwla"] }
  ],
  "files": ["./App.auwla"]
}
