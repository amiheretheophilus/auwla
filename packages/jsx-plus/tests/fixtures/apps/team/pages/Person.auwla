import type { Member } from '../api';
import { Card } from '../components/Card.auwla';
import { note } from '../lifecycle';

export function Person() {
  // Prepared before the route commits: the previous page stays until this person has loaded.
  const member = $routed(({ params }) => $fetch<Member>(`/api/people/${params.id}`));

  $effect(() => {
    const previous = document.title;
    document.title = `${member.name} · Team`;
    note(`person:${member.id}`);
    return () => {
      document.title = previous;
      note(`person:${member.id}:left`);
    };
  });

  return (
    <Card>
      <h2 slot="header">member.name</h2>
      <p class="role">member.role</p>
      <a slot="actions" route-to="/people">"Back to everyone"</a>
    </Card>
  );
}
