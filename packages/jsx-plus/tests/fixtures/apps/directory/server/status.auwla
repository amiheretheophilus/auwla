// Ordinary backend code in `.auwla`: a Hono app and a Node built-in, with no markup and nothing
// reactive. It is in the server folder, so it compiles as the plain code written here.
import { Hono } from 'hono';
import { randomUUID } from 'node:crypto';
import { allPeople } from './people.auwla';

const started = new Date().toISOString();
const instance = randomUUID();

/** Mounted by `server.ts`: `GET /api/status`. */
export const api = new Hono().basePath('/api');

api.get('/status', (c) => c.json({ people: allPeople().length, started, instance }));
