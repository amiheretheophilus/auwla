import { people } from "../data";
import { brief, crewIds } from "../state";
import { Icon } from "./ui.auwla";

export function Hero() {
  <style>
    .hero {
      display: grid;
      grid-template-columns: 1fr @850:1fr 1fr;
      align-items: center;
      gap: 34px @1150:44px;
      padding: 16px 0 40px @850:24px 0 58px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 5px 12px 5px 5px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: var(--card);
      font-size: 10px @600:11px;
      font-weight: 700;
      letter-spacing: 1px;
      span { padding: 4px 9px; border-radius: 13px; background: var(--yellow); letter-spacing: 0; }
    }

    h1 {
      max-width: 700px;
      margin: 22px 0 20px;
      font-size: 40px @600:50px @1150:58px @1600:63px;
      font-weight: 780;
      line-height: 1.07;
      letter-spacing: -2.2px @1150:-3px;
    }

    .lead {
      max-width: 470px;
      margin: 0 0 24px;
      color: #606873;
      font-size: 15px;
      line-height: 1.7;
    }

    .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 24px; }

    .proof {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 26px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.55;
      strong { color: #25272b; font-weight: 600; }
    }
    .avatars {
      display: flex;
      padding-left: 6px;
      img {
        width: 36px;
        height: 36px;
        margin-left: -6px;
        border: 2px solid var(--paper);
        border-radius: 50%;
        background: #dce7fa;
        object-fit: cover;
      }
    }

    /* The artwork: a blue panel with cards floating over it. */
    .art {
      position: relative;
      width: 100% @600:min(510px, 95%) @850:auto;
      height: 290px @600:330px @1600:360px;
      margin: 10px auto 0 @850:4px 4px 0 14px;
    }
    .sun {
      position: absolute;
      top: -9px;
      right: 8px;
      width: 105px @600:128px;
      height: 105px @600:128px;
      border-radius: 50%;
      background: var(--yellow);
    }
    .panel {
      position: absolute;
      inset: 34px 0 0 6px @600:37px 0 0 14px;
      overflow: hidden;
      border-radius: 32px 32px 52px 32px;
      background: var(--blue);
      svg { position: absolute; inset: 0; width: 100%; height: 100%; }
    }
    .caption {
      position: absolute;
      bottom: 16px;
      left: 22px;
      color: #fff;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
      line-height: 1.5;
      opacity: 0.8;
    }

    .brief {
      position: absolute;
      top: 91px;
      left: 8px @1150:24px;
      width: 79% @1150:75%;
      padding: 16px 18px @600:20px 23px;
      border: 1px solid var(--line);
      border-radius: 19px;
      background: var(--card);
      box-shadow: 0 14px 38px #05215a26;
      transform: rotate(-5deg);
      h3 {
        max-width: 260px;
        margin: 12px 0 18px;
        font-size: 20px @600:24px;
        line-height: 1.22;
        letter-spacing: -0.8px;
      }
    }
    .brief-top { display: flex; align-items: center; justify-content: space-between; color: var(--blue); }
    .brief-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #626a72;
      font-size: 12px;
      i { display: inline-block; width: 7px; height: 7px; margin-right: 5px; border-radius: 50%; background: #53a66a; }
      a {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--blue-soft);
        color: var(--blue);
      }
    }

    .person {
      position: absolute;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px @600:10px 13px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: var(--card);
      box-shadow: 0 8px 30px #1423411a;
      img { width: 36px @600:40px; height: 36px @600:40px; border-radius: 50%; object-fit: cover; background: #e2e8f2; }
      strong { display: block; margin-bottom: 4px; font-size: 12px; }
      div > span { display: block; color: var(--muted); font-size: 11px; }
    }
    .one { top: 11px; left: 4px; width: 230px @600:250px; transform: rotate(-4deg); }
    .two { right: -4px; bottom: 4px; width: 235px @600:265px; transform: rotate(4deg); }
    .match { width: 19px; height: 19px; margin-left: auto; border-radius: 50%; background: var(--yellow); }
    .check {
      display: grid;
      place-items: center;
      width: 27px;
      height: 27px;
      margin-left: auto;
      border-radius: 50%;
      background: var(--ink);
      color: var(--yellow);
    }

    .sticker {
      position: absolute;
      top: 64px @600:73px;
      right: -4px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      width: 76px @600:94px;
      height: 76px @600:94px;
      border-radius: 50%;
      background: var(--yellow);
      font-size: 10px @600:12px;
      line-height: 1.25;
      text-align: center;
      transform: rotate(12deg);
    }
  </style>

  const [ama, kwame, esi] = people;

  return (
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <div class="pill"><span>"NEW"</span>; "YOUR NEXT GOOD IDEA STARTS HERE"</div>
        <h1 id="hero-title">"Find your people."; <br />; "Build something "; <span class="accent">"great."</span></h1>
        <p class="lead">
          "Different skills. Shared ambition. Meet independent minds and put your next big idea in good company."
        </p>
        <div class="actions">
          <a class="button primary" route-to="/new">"Start with an idea"; <Icon name="arrow" /></a>
          <a class="text-button" route-to="/studio">"Meet your crew"; <Icon name="chevron" size={15} /></a>
        </div>
        <div class="proof">
          <div class="avatars">
            <img src=(ama!.portrait) alt="" />
            <img src=(kwame!.portrait) alt="" />
            <img src=(esi!.portrait) alt="" />
          </div>
          <span>"Small teams."; <br />; <strong>"Extraordinary possibilities."</strong></span>
        </div>
      </div>

      <div class="art" aria-label="A shared idea brings different people together">
        <div class="sun"></div>
        <div class="panel">
          <span class="caption">"THE NEXT BIG THING"; <br />; "IS A TEAM THING."</span>
          <svg viewBox="0 0 520 320" fill="none" aria-hidden="true">
            <path
              d="M30 100Q160 20 270 160T500 230M20 270Q160 290 260 160T460 60"
              stroke="white" stroke-opacity=".24" stroke-width="1.5" stroke-dasharray="6 8"
            />
            <circle cx="260" cy="160" r="75" stroke="white" stroke-opacity=".12" />
          </svg>
        </div>
        <div class="person one">
          <img src=(ama!.portrait) alt="" />
          <div><strong>ama!.name</strong><span>"Design with a little heart."</span></div>
          <span class="match"></span>
        </div>
        <div class="brief">
          <div class="brief-top"><span class="tiny-label">"YOUR NEXT CHAPTER"</span><Icon name="spark" /></div>
          <h3>brief.name</h3>
          <div class="brief-footer">
            <span><i></i>; "{crewIds.length} collaborator{crewIds.length === 1 ? "" : "s"} on board"</span>
            <a route-to="/studio" aria-label="Open your studio"><Icon name="arrow" size={16} /></a>
          </div>
        </div>
        <div class="person two">
          <img src=(kwame!.portrait) alt="" />
          <div><strong>kwame!.name</strong><span>"A good idea, brought to life."</span></div>
          <span class="check"><Icon name="check" size={15} /></span>
        </div>
        <div class="sticker">
          <Icon name="spark" size={18} />
          <span>"Better"; <br />; <strong>"together."</strong></span>
        </div>
      </div>
    </section>
  );
}
