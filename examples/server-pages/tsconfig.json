{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "@memoized-dom/compiler/jsx"],
    "paths": {
      "#server-functions": ["./.memoized/server-functions.d.ts"]
    }
  },
  "include": ["*.ts", "src", "server", ".memoized/**/*.d.ts"],
  "exclude": ["dist"]
}
