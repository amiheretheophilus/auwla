# Use a development Neon branch locally. Set DATABASE_URL in the host environment for production.
DATABASE_URL=

# Better Auth. Use the public origin of the app in production.
BETTER_AUTH_URL=http://127.0.0.1:3070
BETTER_AUTH_SECRET=
# Other addresses the app is reached at, comma separated. Locally, 127.0.0.1 and localhost on the
# same port are both trusted already.
BETTER_AUTH_TRUSTED_ORIGINS=

# First local staff account, used by bun run auth:setup.
TRIAXIS_ANALYST_EMAIL=analyst@triaxis.test
TRIAXIS_ANALYST_PASSWORD=
# Optional SQLite path. Defaults to .local/analyst.sqlite.
TRIAXIS_DESK_DB=

# Payment details members see on /app/subscribe, one per method. Leave a method empty until
# the owner gives its details; members are then told to ask for them.
TRIAXIS_PAY_BANK=
TRIAXIS_PAY_MOBILE_MONEY=
TRIAXIS_PAY_USDT=
