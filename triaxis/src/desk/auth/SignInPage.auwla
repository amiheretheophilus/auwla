import { AuthSplit } from '../../auth/AuthSplit.auwla';
import { DeskHeader } from '../layout/DeskHeader.auwla';
import { SignInForm } from './SignInForm.auwla';

/** `/desk/sign-in`: staff only. Members are turned away by the server and sent to /sign-in. */
export function SignInPage({ enabled }: { enabled: boolean }) {
  return (
    <AuthSplit
      first="Analyst"
      second="desk"
      lede="Trade ideas for forex, crypto and synthetics, checked before they reach members."
      title="Staff sign in"
      text="Approved analysts only. Use the staff email and password set up for you.">
      <DeskHeader slot="header" staff={null} />
      <SignInForm enabled={enabled} />
    </AuthSplit>
  );
}
