import { navigate } from '@memoized-dom/router';
import { login } from '#server-functions';
import { PasswordField } from '../../auth/PasswordField.auwla';

<style>
  .sign-in {
    display: grid;
    gap: 1.1rem;
    width: min(100%, 24rem);
  }

  .sign-in .desk-button {
    width: 100%;
    margin-top: .35rem;
  }

  .sign-in .desk-button span {
    transition: translate .3s var(--desk-ease);
  }

  .sign-in .desk-button:hover span {
    translate: .25rem 0;
  }

  .sign-in__note,
  .sign-in__error {
    margin: 0;
    padding: .75rem .9rem;
    border-left: 2px solid var(--desk-rule);
    background: var(--desk-paper);
    color: var(--desk-muted);
    font-size: .875rem;
    line-height: 1.45;
  }

  .sign-in__error {
    border-left-color: var(--desk-accent);
    color: var(--desk-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sign-in__error {
      animation: tx-rise .45s var(--desk-ease) both;
    }
  }
</style>

export function SignInForm({ enabled }: { enabled: boolean }) {
  const form = $forms(async (fields: FormData) => {
    const email = String(fields.get('email') ?? '').trim();
    const password = String(fields.get('password') ?? '');
    const signedIn = await login(email, password);
    navigate('/desk', { replace: true });
    return signedIn;
  });

  return (
    <form class="sign-in" method="post" onSubmit={form.submit}>
      <label class="desk-label" for="desk-email">
        "Staff email"
        <input id="desk-email" name="email" type="email" autocomplete="username" maxlength={254} required />
      </label>
      <PasswordField label="Password" autocomplete="current-password" id="desk-password" />
      <button class="desk-button" type="submit" disabled={form.pending}>
        form.pending ? "Signing in…" : "Sign in"
        if (!form.pending) {
          <span aria-hidden="true">"→"</span>
        }
      </button>
      if (!enabled && form.errors.length === 0) {
        <p class="sign-in__note">"Run the local auth setup and restart the dev server to enable sign-in."</p>
      }
      if (form.errors.length > 0) {
        <p class="sign-in__error" role="alert">form.errors[0]?.message</p>
      }
    </form>
  );
}
