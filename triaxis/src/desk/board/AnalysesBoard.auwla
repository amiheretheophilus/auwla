import { navigate } from '@memoized-dom/router';
import { startAnalysis } from '#server-functions';
import { analysisLabel, statusLabels, type AnalysisStatus, type AnalysisSummary, type StaffMember } from '../analysis';
import { axes, isAxis, markets } from '../draft/model/signal-fields';
import { StaffBadge } from '../StaffBadge.auwla';

<style>
  .board-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .kicker {
    margin: 0 0 .75rem;
    color: var(--desk-accent);
    font-weight: 500;
  }

  .board-title h1 {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: .92;
    letter-spacing: -.07em;
  }

  .board-title__side {
    display: grid;
    justify-items: end;
    gap: .75rem;
  }

  .board-title__side p {
    max-width: 30ch;
    margin: 0;
    color: var(--desk-muted);
    font-size: .875rem;
    line-height: 1.5;
    text-align: right;
  }

  .create-error {
    color: var(--desk-accent);
  }

  /* Status tabs, each with its count under the other filters. */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--desk-rule);
    list-style: none;
  }

  .tab {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: .45rem;
    padding: .8rem 1.1rem .9rem 0;
    margin-right: 1.1rem;
    border: 0;
    background: none;
    color: var(--desk-muted);
    font: inherit;
    font-size: .92rem;
    cursor: pointer;
    transition: color .2s ease;
  }

  .tab::after {
    position: absolute;
    right: 1.1rem;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--desk-ink);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .4s var(--desk-ease);
  }

  .tab:hover {
    color: var(--desk-ink);
  }

  .tab[aria-pressed="true"] {
    color: var(--desk-ink);
  }

  .tab[aria-pressed="true"]::after {
    transform: scaleX(1);
  }

  .tab small {
    font-family: var(--desk-mono);
    font-size: .72rem;
  }

  .tab:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: 2px;
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(2, minmax(9rem, 1fr)) minmax(12rem, 1.6fr) repeat(2, minmax(8.5rem, .9fr)) auto;
    align-items: end;
    gap: .9rem;
    padding: 1.1rem 0 1.4rem;
  }

  .clear {
    min-height: 2.9rem;
    padding: 0 .2rem;
    border: 0;
    background: none;
    color: var(--desk-accent);
    font: inherit;
    font-size: .85rem;
    white-space: nowrap;
    cursor: pointer;
  }

  .clear:disabled {
    color: var(--desk-muted);
    opacity: .5;
    cursor: default;
  }

  .clear:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: 2px;
  }

  /* The list: one ruled row per analysis, the whole row a link. */
  .list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--desk-ink);
    list-style: none;
  }

  .row,
  .list-head {
    display: grid;
    grid-template-columns: minmax(11rem, 1.25fr) minmax(9rem, 1fr) minmax(7.5rem, .75fr) minmax(0, 2fr) minmax(8rem, .8fr);
    align-items: center;
    gap: 1rem;
    padding: 1rem .5rem;
  }

  .list-head {
    padding-block: .6rem;
    color: var(--desk-muted);
    font-size: .72rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .list li {
    border-bottom: 1px solid var(--desk-rule);
  }

  .row {
    color: inherit;
    text-decoration: none;
    transition: background-color .2s ease;
  }

  .row:hover {
    background: var(--desk-surface);
  }

  .row:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: -2px;
  }

  .asset {
    display: grid;
    gap: .2rem;
    min-width: 0;
  }

  .asset strong {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -.02em;
  }

  .asset strong::before {
    flex: none;
    width: .5rem;
    height: .5rem;
    border-radius: 50%;
    background: var(--axis-color, var(--desk-rule));
    content: "";
  }

  .asset[data-axis="forex"] { --axis-color: #3987e5; }
  .asset[data-axis="crypto"] { --axis-color: #9085e9; }
  .asset[data-axis="synthetics"] { --axis-color: #eda100; }

  .asset span {
    color: var(--desk-muted);
    font-family: var(--desk-mono);
    font-size: .7rem;
  }

  .attention {
    overflow: hidden;
    color: var(--desk-muted);
    font-size: .85rem;
    line-height: 1.4;
    display: -webkit-box;
    line-clamp: 2;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .row[data-status="rejected"] .attention {
    color: var(--desk-accent);
  }

  .updated {
    color: var(--desk-muted);
    font-family: var(--desk-mono);
    font-size: .72rem;
    text-align: right;
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: .9rem;
    padding: 3rem 0;
    border-top: 1px solid var(--desk-ink);
  }

  .empty h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -.04em;
  }

  .empty p {
    max-width: 44ch;
    margin: 0;
    color: var(--desk-muted);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .list li {
      animation: tx-rise .5s var(--desk-ease) both;
    }

    .list li:nth-child(2) { animation-delay: .03s; }
    .list li:nth-child(3) { animation-delay: .06s; }
    .list li:nth-child(4) { animation-delay: .09s; }
    .list li:nth-child(5) { animation-delay: .12s; }
    .list li:nth-child(n + 6) { animation-delay: .15s; }
  }

  @media (max-width: 64rem) {
    .filters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 52rem) {
    .list-head {
      display: none;
    }

    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "asset status"
        "attention attention"
        "author updated";
      row-gap: .6rem;
    }

    .asset { grid-area: asset; }
    .row .status { grid-area: status; }
    .attention { grid-area: attention; }
    .author { grid-area: author; }
    .updated { grid-area: updated; }
  }

  @media (max-width: 36rem) {
    .filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .board-title__side {
      justify-items: start;
    }

    .board-title__side p {
      text-align: left;
    }
  }
</style>

const statusOrder: AnalysisStatus[] = ['ready', 'rejected', 'incomplete', 'posted'];

const updatedFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'UTC',
});

function formatUpdated(value: string) {
  return updatedFormat.format(new Date(value)) + ' UTC';
}

function directionLabel(axis: string, direction: string) {
  if (direction === 'buy') return axis === 'crypto' ? 'Long' : 'Buy';
  if (direction === 'sell') return axis === 'crypto' ? 'Short' : 'Sell';
  return 'No direction';
}

interface BoardProps {
  staff: StaffMember;
  analyses: AnalysisSummary[];
  authors: StaffMember[];
}

export function AnalysesBoard({ staff, analyses, authors }: BoardProps) {
  let status: AnalysisStatus | 'all' = 'all';
  let analyst = 'all';
  let market = 'all';
  let search = '';
  let from = '';
  let to = '';

  // Every filter except the status, so each tab can show what it would hold.
  const filtered = analyses.filter(analysis => {
    if (analyst === 'mine' && analysis.author.id !== staff.id) return false;
    if (analyst !== 'all' && analyst !== 'mine' && analysis.author.id !== analyst) return false;
    if (market !== 'all' && analysis.axis !== market) return false;
    if (search.trim() && !analysis.symbol.toLowerCase().includes(search.trim().toLowerCase())) return false;
    const day = analysis.updatedAt.slice(0, 10);
    if (from && day < from) return false;
    if (to && day > to) return false;
    return true;
  });
  const visible = status === 'all' ? filtered : filtered.filter(analysis => analysis.status === status);
  const countOf = (value: AnalysisStatus) => filtered.filter(analysis => analysis.status === value).length;
  const filtering = status !== 'all' || analyst !== 'all' || market !== 'all' || search !== '' || from !== '' || to !== '';

  function clearFilters() {
    status = 'all';
    analyst = 'all';
    market = 'all';
    search = '';
    from = '';
    to = '';
  }

  const create = $forms(() => {
    const request = startAnalysis();
    $track(create).onSuccess(result => {
      if (result.ok) navigate('/desk/analyses/:id', { params: { id: String(result.id) } });
    });
    return request;
  });

  return (
    <section aria-labelledby="board-heading">
      <div class="board-title">
        <div>
          <p class="kicker">"Signal desk"</p>
          <h1 id="board-heading">"Analyses"</h1>
        </div>
        <div class="board-title__side">
          <p>"Every analyst's ideas in one place. Rejected ideas stay here with the check that stopped them."</p>
          <form onSubmit={create.submit}>
            <button class="desk-button" type="submit" disabled={create.pending}>
              create.pending ? "Starting…" : "New analysis"
              if (!create.pending) {
                <span aria-hidden="true">"+"</span>
              }
            </button>
          </form>
          if (create.result && !create.result.ok) {
            <p class="create-error" role="alert">create.result.message</p>
          } else if (create.errors.length > 0) {
            <p class="create-error" role="alert">"The analysis could not be started. Check your session and try again."</p>
          }
        </div>
      </div>

      <ul class="tabs" aria-label="Status">
        <li>
          <button class="tab" type="button" aria-pressed={status === 'all'} onClick={() => status = 'all'}>
            "All" <small>filtered.length</small>
          </button>
        </li>
        for (const value of statusOrder) {
          <li key={value}>
            <button class="tab" type="button" aria-pressed={status === value} onClick={() => status = value}>
              statusLabels[value] <small>countOf(value)</small>
            </button>
          </li>
        }
      </ul>

      <div class="filters">
        <label class="desk-label">
          "Analyst"
          <select onChange={event => analyst = event.currentTarget.value}>
            <option value="all" selected={analyst === 'all'}>"All analysts"</option>
            <option value="mine" selected={analyst === 'mine'}>"Mine"</option>
            for (const author of authors) {
              <option key={author.id} value={author.id} selected={analyst === author.id}>author.name</option>
            }
          </select>
        </label>
        <label class="desk-label">
          "Market"
          <select onChange={event => market = event.currentTarget.value}>
            <option value="all" selected={market === 'all'}>"All markets"</option>
            for (const axis of axes) {
              <option key={axis} value={axis} selected={market === axis}>markets[axis].label</option>
            }
          </select>
        </label>
        <label class="desk-label">
          "Asset"
          <input type="search" placeholder="Search, e.g. XAUUSD" value={search} onInput={event => search = event.currentTarget.value} />
        </label>
        <label class="desk-label">
          "Updated from"
          <input type="date" value={from} max={to || undefined} onInput={event => from = event.currentTarget.value} />
        </label>
        <label class="desk-label">
          "Updated to"
          <input type="date" value={to} min={from || undefined} onInput={event => to = event.currentTarget.value} />
        </label>
        <button class="clear" type="button" disabled={!filtering} onClick={clearFilters}>"Clear filters"</button>
      </div>

      if (analyses.length === 0) {
        <div class="empty">
          <h2>"No analyses yet"</h2>
          <p>"Start the first one with New analysis. It is saved as a draft until every check passes and you post it."</p>
        </div>
      } else if (visible.length === 0) {
        <div class="empty">
          <h2>"Nothing matches these filters"</h2>
          <p>"Try another analyst, market or date range."</p>
          <button class="desk-button desk-button--quiet" type="button" onClick={clearFilters}>"Clear filters"</button>
        </div>
      } else {
        <div>
          <div class="list-head" aria-hidden="true">
            <span>"Analysis"</span>
            <span>"Analyst"</span>
            <span>"Status"</span>
            <span>"Checks"</span>
            <span>"Updated"</span>
          </div>
          <ul class="list" aria-label="Analyses">
            for (const analysis of visible) {
              <li key={analysis.id}>
                <a class="row" data-status={analysis.status}
                  route-to={{ path: '/desk/analyses/:id', params: { id: String(analysis.id) } }}>
                  <span class="asset" data-axis={analysis.axis}>
                    <strong>analysis.symbol || "No asset yet"</strong>
                    <span>analysisLabel(analysis.id) + " · " + (isAxis(analysis.axis) ? markets[analysis.axis].label : analysis.axis) + " · " + directionLabel(analysis.axis, analysis.direction)</span>
                  </span>
                  <span class="author"><StaffBadge member={analysis.author} /></span>
                  <span class="status" data-status={analysis.status}>statusLabels[analysis.status]</span>
                  <span class="attention">analysis.attention</span>
                  <span class="updated">formatUpdated(analysis.updatedAt)</span>
                </a>
              </li>
            }
          </ul>
        </div>
      }
    </section>
  );
}
