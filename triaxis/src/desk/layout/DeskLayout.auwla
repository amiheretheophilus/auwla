import '../desk-theme.auwla';
import { DraftEditor } from '../draft/DraftEditor.auwla';
import { SignInForm } from '../auth/SignInForm.auwla';
import type { SignalDraft } from '../draft/model/signal-review';

<style>
  body {
    margin: 0;
  }

  .desk {
    min-height: 100vh;
    background: var(--desk-paper);
    color: var(--desk-ink);
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-synthesis: none;
    -webkit-font-smoothing: antialiased;
  }

  .desk-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.65rem;
    padding-inline: var(--desk-gutter);
    border-bottom: 1px solid var(--desk-rule);
    background: #f1ebe1e6;
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .desk-header a {
    color: inherit;
    text-decoration: none;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .wordmark small {
    padding-left: .65rem;
    border-left: 1px solid var(--desk-rule);
    color: var(--desk-muted);
    font-size: .8rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .wordmark__mark {
    position: relative;
    width: 1.1rem;
    height: 1.1rem;
  }

  .wordmark__mark span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: var(--desk-ink);
    transition: rotate .5s var(--desk-ease);
  }

  .wordmark__mark span:nth-child(1) {
    background: var(--desk-accent);
    rotate: 60deg;
  }

  .wordmark__mark span:nth-child(2) {
    rotate: -60deg;
  }

  .wordmark:hover .wordmark__mark span:nth-child(1) {
    rotate: 120deg;
  }

  .wordmark:hover .wordmark__mark span:nth-child(2) {
    rotate: 0deg;
  }

  .wordmark:hover .wordmark__mark span:nth-child(3) {
    rotate: 60deg;
  }

  .desk-header nav {
    display: flex;
    align-items: center;
    gap: clamp(.75rem, 2vw, 1.75rem);
    font-size: .875rem;
  }

  .desk-header form {
    margin: 0;
  }

  .site-link {
    color: var(--desk-muted);
    transition: color .2s ease;
  }

  .site-link:hover {
    color: var(--desk-ink);
  }

  /* The signed-in workspace. */
  .desk-main {
    max-width: 82rem;
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 3.5rem) var(--desk-gutter) 0;
  }

  .desk-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .desk-kicker {
    margin: 0 0 .75rem;
    color: var(--desk-accent);
    font-weight: 500;
  }

  .desk-title h1 {
    display: flex;
    flex-wrap: wrap;
    column-gap: .2em;
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: .92;
    letter-spacing: -.07em;
  }

  .desk-title__meta {
    max-width: 30ch;
    margin: 0;
    color: var(--desk-muted);
    font-size: .875rem;
    line-height: 1.5;
  }

  /* Each word rises out of its own clipped line box. */
  .word {
    display: block;
    overflow: hidden;
    padding-bottom: .1em;
    margin-bottom: -.1em;
  }

  .word span {
    display: block;
  }

  .risk-note {
    margin: 0;
    padding: 2rem 0;
    color: var(--desk-muted);
    font-size: .8rem;
  }

  /* Signed out: the photograph on one side, the form on the other. */
  .sign-in-page {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    min-height: calc(100svh - 3.65rem);
  }

  .sign-in-art {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 4rem) var(--desk-gutter);
    overflow: hidden;
    background: #e8d9c6;
  }

  .sign-in-art img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }

  .sign-in-art::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, #eae0d2 0%, #eae0d2cc 22%, #eae0d200 60%),
      linear-gradient(90deg, #eee5d7aa 0%, #eee5d700 55%);
    content: "";
  }

  .sign-in-art h1 {
    display: flex;
    flex-wrap: wrap;
    column-gap: .2em;
    margin: 0;
    font-size: clamp(3rem, 7.5vw, 8rem);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.07em;
  }

  .sign-in-art p {
    max-width: 34ch;
    margin: 0;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.35;
    letter-spacing: -.02em;
  }

  .sign-in-panel {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 5rem) var(--desk-gutter);
    background: var(--desk-surface);
    border-left: 1px solid var(--desk-rule);
  }

  .sign-in-panel__intro h2 {
    margin: 0;
    font-size: clamp(1.75rem, 2.8vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -.05em;
  }

  .sign-in-panel__intro p {
    max-width: 34ch;
    margin: .6rem 0 0;
    color: var(--desk-muted);
    line-height: 1.5;
  }

  .sign-in-panel .risk-note {
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--desk-rule);
    width: min(100%, 24rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .word span {
      animation: tx-word 1.1s var(--desk-ease) both;
    }

    .word:nth-child(2) span {
      animation-delay: .12s;
    }

    .desk-kicker,
    .desk-title__meta {
      animation: tx-rise .9s var(--desk-ease) .1s both;
    }

    .sign-in-art img {
      animation: tx-settle 1.8s var(--desk-ease) both;
    }

    .sign-in-art p {
      animation: tx-rise 1s var(--desk-ease) .3s both;
    }

    .sign-in-panel > * {
      animation: tx-rise .9s var(--desk-ease) both;
    }

    .sign-in-panel > :nth-child(2) {
      animation-delay: .1s;
    }

    .sign-in-panel > :nth-child(3) {
      animation-delay: .2s;
    }
  }

  @media (max-width: 52rem) {
    .sign-in-page {
      grid-template-columns: minmax(0, 1fr);
    }

    .sign-in-art {
      min-height: 17rem;
    }

    .sign-in-panel {
      align-content: start;
      border-left: 0;
      border-top: 1px solid var(--desk-rule);
    }
  }

  @media (max-width: 30rem) {
    .wordmark small,
    .site-link {
      display: none;
    }
  }
</style>

export function DeskLayout({ draft, enabled }: { draft: SignalDraft | null; enabled: boolean }) {
  return (
    <div class="desk">
      <header class="desk-header">
        <a class="wordmark" href="/" aria-label="Triaxis home">
          <span class="wordmark__mark" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          "Triaxis"
          <small>"Desk"</small>
        </a>
        <nav aria-label="Desk navigation">
          <a class="site-link" href="/">"Public site"</a>
          if (draft) {
            <form method="post" action="/desk/sign-out">
              <button class="desk-button desk-button--quiet" type="submit">"Sign out"</button>
            </form>
          }
        </nav>
      </header>

      if (draft) {
        <main class="desk-main">
          <div class="desk-title">
            <div>
              <p class="desk-kicker">"Signal desk"</p>
              <h1>
                <span class="word"><span>"Analyst"</span></span>
                <span class="word"><span>"desk"</span></span>
              </h1>
            </div>
            <p class="desk-title__meta">"Enter the idea and save the draft. The checks run on every save, and nothing is posted until they all pass."</p>
          </div>
          <DraftEditor initial={draft} />
          <p class="risk-note">"Trading involves risk. Signals are for informational purposes only."</p>
        </main>
      } else {
        <main class="sign-in-page">
          <section class="sign-in-art" aria-labelledby="desk-heading">
            <img src="/images/market-axes.webp" alt="" width={1536} height={1024} />
            <h1 id="desk-heading">
              <span class="word"><span>"Analyst"</span></span>
              <span class="word"><span>"desk"</span></span>
            </h1>
            <p>"Trade ideas for forex, crypto and synthetics, checked before they reach members."</p>
          </section>

          <section class="sign-in-panel" aria-labelledby="sign-in-heading">
            <div class="sign-in-panel__intro">
              <h2 id="sign-in-heading">"Staff sign in"</h2>
              <p>"Approved analysts only. Use the staff email and password set up for this desk."</p>
            </div>
            <SignInForm enabled={enabled} />
            <p class="risk-note">"Trading involves risk. Signals are for informational purposes only."</p>
          </section>
        </main>
      }
    </div>
  );
}
