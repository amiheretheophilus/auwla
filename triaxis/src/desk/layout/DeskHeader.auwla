import type { StaffMember } from '../analysis';
import { Wordmark } from '../../brand/Wordmark.auwla';
import { StaffBadge } from '../StaffBadge.auwla';

<style>
  .desk-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.65rem;
    padding-inline: var(--desk-gutter);
    border-bottom: 1px solid var(--desk-rule);
    background: #f1ebe1e6;
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .desk-header nav {
    display: flex;
    align-items: center;
    gap: clamp(.75rem, 2vw, 1.5rem);
    font-size: .875rem;
  }

  .desk-header form {
    margin: 0;
  }

  .nav-link {
    color: var(--desk-muted);
    text-decoration: none;
    transition: color .2s ease;
  }

  .nav-link:hover {
    color: var(--desk-ink);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: 3px;
  }

  .identity {
    padding-left: clamp(.75rem, 2vw, 1.5rem);
    border-left: 1px solid var(--desk-rule);
  }

  @media (max-width: 40rem) {
    .nav-link {
      display: none;
    }
  }
</style>

/** The desk's header. With `staff`, it shows who is signed in and a sign-out button. */
export function DeskHeader({ staff }: { staff: StaffMember | null }) {
  return (
    <header class="desk-header">
      if (staff) {
        <Wordmark href="/desk" label="All analyses" area="Desk" />
      } else {
        <Wordmark href="/" label="Triaxis home" area="Desk" />
      }
      <nav aria-label="Desk navigation">
        if (staff) {
          <a class="nav-link" href="/desk">"Analyses"</a>
          if (staff.role === 'admin') {
            <a class="nav-link" href="/desk/payments">"Payments"</a>
          }
        }
        <a class="nav-link" href="/">"Public site"</a>
        if (staff) {
          <span class="identity"><StaffBadge member={staff} role={true} /></span>
          <form method="post" action="/desk/sign-out">
            <button class="desk-button desk-button--quiet" type="submit">"Sign out"</button>
          </form>
        }
      </nav>
    </header>
  );
}
