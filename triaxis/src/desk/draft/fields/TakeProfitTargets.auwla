<style>
  .targets {
    display: grid;
    gap: .6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .target {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: .75rem;
  }

  .target label {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: center;
  }

  /* The target number sits in a tab joined to the left of its field. */
  .target label span {
    display: grid;
    place-items: center;
    align-self: stretch;
    border: 1px solid #d6cbbd;
    border-right: 0;
    border-radius: .75rem 0 0 .75rem;
    background: var(--desk-surface);
    color: var(--desk-muted);
    font-family: var(--desk-mono);
    font-size: .75rem;
  }

  .target input {
    border-radius: 0 .75rem .75rem 0;
  }

  .remove {
    padding: .4rem .2rem;
    border: 0;
    background: none;
    color: var(--desk-muted);
    font: inherit;
    font-size: .82rem;
    text-decoration: underline;
    text-decoration-color: #0000;
    text-underline-offset: .25em;
    cursor: pointer;
    transition: color .2s ease, text-decoration-color .2s ease;
  }

  .remove:hover {
    color: var(--desk-accent);
    text-decoration-color: currentColor;
  }

  .remove:disabled {
    opacity: .4;
    cursor: default;
  }

  .remove:disabled:hover {
    color: var(--desk-muted);
    text-decoration-color: #0000;
  }

  .remove:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: 2px;
  }

  .add {
    margin-top: 1rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .target {
      animation: tx-rise .4s var(--desk-ease) both;
    }
  }
</style>

interface TargetRow {
  id: number;
  label: string;
  value: string;
}

interface TargetsProps {
  targets: TargetRow[];
  addTarget: () => void;
  removeTarget: (id: number) => void;
  setTarget: (id: number, value: string) => void;
}

export function TakeProfitTargets({ targets, addTarget, removeTarget, setTarget }: TargetsProps) {
  return (
    <section class="desk-row" aria-labelledby="targets-heading">
      <div class="desk-row__head">
        <h2 id="targets-heading">"Take-profit targets"</h2>
        <p>"Only TP1 is required. Add more in order from entry; empty boxes at the end are ignored."</p>
      </div>
      <div>
        <ol class="targets">
          for (const target of targets) {
            <li key={target.id} class="target">
              <label>
                <span>target.label</span>
                <input name="target" inputmode="decimal" maxlength={64} value={target.value}
                  aria-label={target.label + ' price'}
                  onInput={(event) => setTarget(target.id, event.currentTarget.value)} />
              </label>
              <button class="remove" type="button" disabled={targets.length === 1} aria-label={'Remove ' + target.label}
                onClick={() => removeTarget(target.id)}>"Remove"</button>
            </li>
          }
        </ol>
        <button class="desk-button desk-button--quiet add" type="button" onClick=addTarget>"+ Add target"</button>
      </div>
    </section>
  );
}
