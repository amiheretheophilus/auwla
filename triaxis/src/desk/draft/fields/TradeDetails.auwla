import { axes, isAxis, markets, type SignalFields } from '../model/signal-fields';

<style>
  .instrument-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 49rem) {
    .instrument-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 25rem) {
    .instrument-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

type TradeField = 'axis' | 'symbol' | 'direction' | 'entryType';

interface TradeDetailsProps {
  fields: Pick<SignalFields, TradeField>;
  change: (name: TradeField, value: string) => void;
}

/** The instrument row. The editor owns the values; this reports each change. */
export function TradeDetails({ fields, change }: TradeDetailsProps) {
  const symbols: readonly string[] = isAxis(fields.axis) ? markets[fields.axis].symbols : [];

  function chooseMarket(event: Event & { currentTarget: HTMLSelectElement }) {
    change('axis', event.currentTarget.value);
    // An asset belongs to one market, so choosing another market clears it.
    change('symbol', '');
  }

  return (
    <section class="desk-row" aria-labelledby="instrument-heading">
      <div class="desk-row__head">
        <h2 id="instrument-heading">"Instrument"</h2>
        <p>"Axis, asset, direction and how the trade is entered."</p>
      </div>
      <div class="instrument-grid">
        <label class="desk-label">
          "Market"
          <select name="axis" onChange={chooseMarket}>
            for (const option of axes) {
              <option key={option} value={option} selected={fields.axis === option}>markets[option].label</option>
            }
          </select>
        </label>
        <label class="desk-label">
          "Asset"
          <select name="symbol" onChange={(event) => change('symbol', event.currentTarget.value)}>
            <option value="" selected={fields.symbol === ''}>"Choose an asset"</option>
            for (const option of symbols) {
              <option key={option} value={option} selected={fields.symbol === option}>option</option>
            }
          </select>
        </label>
        <label class="desk-label">
          "Direction"
          <select name="direction" onChange={(event) => change('direction', event.currentTarget.value)}>
            <option value="" selected={fields.direction === ''}>"Choose a direction"</option>
            <option value="buy" selected={fields.direction === 'buy'}>fields.axis === 'crypto' ? "Long" : "Buy"</option>
            <option value="sell" selected={fields.direction === 'sell'}>fields.axis === 'crypto' ? "Short" : "Sell"</option>
          </select>
        </label>
        <label class="desk-label">
          "Entry type"
          <select name="entryType" onChange={(event) => change('entryType', event.currentTarget.value)}>
            <option value="" selected={fields.entryType === ''}>"Choose a type"</option>
            <option value="market" selected={fields.entryType === 'market'}>"Market"</option>
            <option value="limit" selected={fields.entryType === 'limit'}>"Limit"</option>
            <option value="stop" selected={fields.entryType === 'stop'}>"Stop"</option>
          </select>
        </label>
      </div>
    </section>
  );
}
