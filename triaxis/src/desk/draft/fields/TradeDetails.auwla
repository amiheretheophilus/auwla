import { axes, isAxis, markets, type SignalFields } from '../model/signal-fields';

<style>
  .instrument {
    min-width: 0;
    margin: 0;
    padding: 1.35rem var(--panel-padding);
    border: 1px solid var(--desk-rule);
    border-radius: var(--panel-radius);
    background: var(--desk-surface);
  }

  h2 {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -.025em;
  }

  .instrument-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  label { display: grid; gap: .4rem; color: var(--desk-muted); font-size: .875rem; }
  select {
    width: 100%;
    min-width: 0;
    min-height: 2.85rem;
    padding: .6rem .75rem;
    border: 1px solid var(--desk-rule);
    border-radius: .45rem;
    background: var(--desk-input);
    color: var(--desk-ink);
    font: inherit;
  }
  select:focus-visible { outline: 2px solid var(--desk-accent); outline-offset: 2px; }

  @media (max-width: 49rem) {
    .instrument-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 25rem) {
    .instrument-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

export function TradeDetails({ fields }: { fields: SignalFields }) {
  let axis = fields.axis;
  let symbol = fields.symbol;
  const symbols: readonly string[] = isAxis(axis) ? markets[axis].symbols : [];

  function chooseMarket(event: Event & { currentTarget: HTMLSelectElement }) {
    axis = event.currentTarget.value;
    symbol = '';
  }

  return (
    <section class="instrument" aria-labelledby="instrument-heading">
      <h2 id="instrument-heading">"Instrument"</h2>
      <div class="instrument-grid">
        <label>
          "Market"
          <select name="axis" onChange={chooseMarket}>
            for (const option of axes) {
              <option key={option} value={option} selected={axis === option}>markets[option].label</option>
            }
          </select>
        </label>
        <label>
          "Asset"
          <select name="symbol" onChange={(event) => symbol = event.currentTarget.value}>
            <option value="" selected={symbol === ''}>"Choose an asset"</option>
            for (const option of symbols) {
              <option key={option} value={option} selected={symbol === option}>option</option>
            }
          </select>
        </label>
        <label>
          "Direction"
          <select name="direction">
            <option value="" selected={fields.direction === ''}>"Choose a direction"</option>
            <option value="buy" selected={fields.direction === 'buy'}>axis === 'crypto' ? "Long" : "Buy"</option>
            <option value="sell" selected={fields.direction === 'sell'}>axis === 'crypto' ? "Short" : "Sell"</option>
          </select>
        </label>
        <label>
          "Entry type"
          <select name="entryType">
            <option value="" selected={fields.entryType === ''}>"Choose a type"</option>
            <option value="market" selected={fields.entryType === 'market'}>"Market"</option>
            <option value="limit" selected={fields.entryType === 'limit'}>"Limit"</option>
            <option value="stop" selected={fields.entryType === 'stop'}>"Stop"</option>
          </select>
        </label>
      </div>
    </section>
  );
}
