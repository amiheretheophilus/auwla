import { TakeProfitTargets } from './TakeProfitTargets.auwla';
import { parsePastedLevels } from '../model/pasted-levels';
import type { SignalFields } from '../model/signal-fields';

<style>
  .price-plan {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    border: 1px solid var(--desk-rule);
    border-radius: var(--panel-radius);
    background: var(--desk-surface);
  }

  .levels { padding: 1.35rem var(--panel-padding); border-inline-end: 1px solid var(--desk-rule); }
  .levels h2 { margin: 0 0 1rem; font-size: 1.15rem; font-weight: 600; letter-spacing: -.025em; }
  .levels label { display: grid; gap: .4rem; margin-top: .8rem; color: var(--desk-muted); font-size: .875rem; }
  input, textarea {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: .65rem .75rem;
    border: 1px solid var(--desk-rule);
    border-radius: .45rem;
    background: var(--desk-input);
    color: var(--desk-ink);
    font: inherit;
    font-variant-numeric: tabular-nums;
  }
  input { min-height: 2.85rem; }
  textarea { resize: vertical; }
  .paste { grid-column: 1 / -1; padding: 1rem var(--panel-padding); border-top: 1px solid var(--desk-rule); }
  .paste summary { cursor: pointer; color: var(--desk-accent); font-size: .9rem; }
  .paste label { display: grid; gap: .45rem; margin: .8rem 0; color: var(--desk-muted); font-size: .875rem; }
  .paste button {
    padding: .45rem .65rem;
    border: 1px solid var(--desk-rule);
    border-radius: .45rem;
    background: var(--desk-input);
    color: var(--desk-accent);
    font: inherit;
    cursor: pointer;
  }
  .paste button:disabled { opacity: .5; cursor: default; }
  .paste p { margin: .65rem 0 0; color: var(--desk-muted); font-size: .875rem; }
  button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 2px solid var(--desk-accent); outline-offset: 2px; }

  @media (max-width: 40rem) {
    .price-plan { grid-template-columns: minmax(0, 1fr); }
    .levels { border-inline-end: 0; border-bottom: 1px solid var(--desk-rule); }
  }
</style>

export function PricePlan({ fields }: { fields: SignalFields }) {
  let entry = fields.entry;
  let stop = fields.stop;
  let targets = fields.targets.map((value, id) => ({ id, value }));
  let nextId = targets.length;
  let pasted = '';
  let pasteMessage = '';
  const numberedTargets = targets.map((row, index) => ({ ...row, label: 'TP' + (index + 1) }));

  function addTarget() {
    targets = [...targets, { id: nextId++, value: '' }];
  }

  function removeTarget(id: number) {
    if (targets.length > 1) targets = targets.filter(row => row.id !== id);
  }

  function setTarget(id: number, value: string) {
    targets = targets.map(row => row.id === id ? { id, value } : row);
  }

  function applyLevels() {
    const parsed = parsePastedLevels(pasted);
    if (!parsed) {
      pasteMessage = 'Enter at least three prices. Put entry first, stop loss second, then the targets.';
      return;
    }

    entry = parsed.entry;
    stop = parsed.stop;
    targets = parsed.targets.map(value => ({ id: nextId++, value }));
    pasteMessage = 'Entry, stop, and targets filled in.';
  }

  return (
    <div class="price-plan">
      <section class="levels" aria-labelledby="levels-heading">
        <h2 id="levels-heading">"Price levels"</h2>
        <label>
          "Entry price"
          <input name="entry" inputmode="decimal" maxlength={64} value={entry} onInput={event => entry = event.currentTarget.value} />
        </label>
        <label>
          "Stop loss"
          <input name="stop" inputmode="decimal" maxlength={64} value={stop} onInput={event => stop = event.currentTarget.value} />
        </label>
        <label>
          "Risk (%) · optional"
          <input name="risk" inputmode="decimal" maxlength={64} value={fields.risk} />
        </label>
      </section>

      <TakeProfitTargets targets={numberedTargets} addTarget={addTarget} removeTarget={removeTarget} setTarget={setTarget} />

      <details class="paste">
        <summary>"Fill several prices at once"</summary>
        <p id="bulk-prices-hint">"Paste entry, stop loss, then targets. Use a new line for each price, or separate them with spaces or commas. Applying replaces the current prices and targets."</p>
        <label>
          "Copied prices"
          <textarea aria-describedby="bulk-prices-hint" rows={4} placeholder={'100\n95\n108\n112'}
            value={pasted} onInput={event => pasted = event.currentTarget.value} />
        </label>
        <button type="button" disabled={pasted.trim() === ''} onClick={applyLevels}>"Apply pasted prices"</button>
        if (pasteMessage) {
          <p role="status">pasteMessage</p>
        }
      </details>
    </div>
  );
}
