import { TakeProfitTargets } from './TakeProfitTargets.auwla';
import { parsePastedLevels } from '../model/pasted-levels';
import type { SignalFields } from '../model/signal-fields';

<style>
  .level-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .paste {
    margin-top: 1.1rem;
    border-top: 1px dashed var(--desk-rule);
  }

  .paste summary {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding-top: .9rem;
    color: var(--desk-accent);
    font-size: .875rem;
    list-style: none;
    cursor: pointer;
  }

  .paste summary::-webkit-details-marker {
    display: none;
  }

  /* A plus that turns into a minus when the panel is open. */
  .paste summary::before {
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: .8rem;
    line-height: 1;
    content: "+";
    transition: rotate .35s var(--desk-ease);
  }

  .paste[open] summary::before {
    content: "−";
    rotate: 180deg;
  }

  .paste__body {
    display: grid;
    gap: .8rem;
    justify-items: start;
    padding-top: .9rem;
  }

  .paste__body p {
    max-width: 60ch;
    margin: 0;
    color: var(--desk-muted);
    font-size: .82rem;
    line-height: 1.45;
  }

  .paste__body .desk-label {
    width: 100%;
  }

  .paste__body textarea {
    font-family: var(--desk-mono);
    font-size: .88rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .paste[open] .paste__body {
      animation: tx-rise .45s var(--desk-ease) both;
    }
  }

  @media (max-width: 36rem) {
    .level-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

export interface TargetRow {
  id: number;
  value: string;
}

type PriceField = 'entry' | 'stop' | 'risk';

interface PricePlanProps {
  fields: Pick<SignalFields, PriceField>;
  targets: TargetRow[];
  change: (name: PriceField, value: string) => void;
  addTarget: () => void;
  removeTarget: (id: number) => void;
  setTarget: (id: number, value: string) => void;
  /** Replaces entry, stop and every target at once. */
  fillLevels: (entry: string, stop: string, targets: string[]) => void;
}

/** Price levels and targets. The editor owns the values; only the pasted text is kept here. */
export function PricePlan({ fields, targets, change, addTarget, removeTarget, setTarget, fillLevels }: PricePlanProps) {
  let pasted = '';
  let pasteMessage = '';
  const numberedTargets = targets.map((row, index) => ({ ...row, label: 'TP' + (index + 1) }));

  function applyLevels() {
    const parsed = parsePastedLevels(pasted);
    if (!parsed) {
      pasteMessage = 'Enter at least three prices. Put entry first, stop loss second, then the targets.';
      return;
    }

    fillLevels(parsed.entry, parsed.stop, parsed.targets);
    pasteMessage = 'Entry, stop, and targets filled in.';
  }

  return (
    <>
      <section class="desk-row" aria-labelledby="levels-heading">
        <div class="desk-row__head">
          <h2 id="levels-heading">"Price levels"</h2>
          <p>"Entry and stop loss. Risk is optional draft data."</p>
        </div>
        <div>
          <div class="level-grid">
            <label class="desk-label">
              "Entry price"
              <input name="entry" inputmode="decimal" maxlength={64} value={fields.entry} onInput={event => change('entry', event.currentTarget.value)} />
            </label>
            <label class="desk-label">
              "Stop loss"
              <input name="stop" inputmode="decimal" maxlength={64} value={fields.stop} onInput={event => change('stop', event.currentTarget.value)} />
            </label>
            <label class="desk-label">
              "Risk (%) · optional"
              <input name="risk" inputmode="decimal" maxlength={64} value={fields.risk} onInput={event => change('risk', event.currentTarget.value)} />
            </label>
          </div>

          <details class="paste">
            <summary>"Fill several prices at once"</summary>
            <div class="paste__body">
              <p id="bulk-prices-hint">"Paste entry, stop loss, then targets. Use a new line for each price, or separate them with spaces or commas. Applying replaces the current prices and targets."</p>
              <label class="desk-label">
                "Copied prices"
                <textarea aria-describedby="bulk-prices-hint" rows={4} placeholder={'100\n95\n108\n112'}
                  value=pasted onInput={event => pasted = event.currentTarget.value} />
              </label>
              <button class="desk-button desk-button--quiet" type="button" disabled=(pasted.trim() === '') onClick=applyLevels>"Apply pasted prices"</button>
              if (pasteMessage) {
                <p role="status">pasteMessage</p>
              }
            </div>
          </details>
        </div>
      </section>

      <TakeProfitTargets targets=numberedTargets addTarget=addTarget removeTarget=removeTarget setTarget=setTarget />
    </>
  );
}
