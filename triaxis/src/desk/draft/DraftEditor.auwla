import { saveSignalDraft } from '#server-functions';
import type { SignalDraft } from './model/signal-review';
import { PricePlan } from './fields/PricePlan.auwla';
import { SignalChecks } from './SignalChecks.auwla';
import { TradeDetails } from './fields/TradeDetails.auwla';

<style>
  /* The form on the left, its checks beside it. */
  .editor {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 22rem);
    align-items: start;
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
  }

  .draft-form {
    min-width: 0;
    counter-reset: desk-section;
  }

  .note-hint {
    margin: .5rem 0 0;
    color: var(--desk-muted);
    font-size: .78rem;
  }

  /* The save bar stays in reach at the bottom of the window while the form scrolls. */
  .actions {
    position: sticky;
    bottom: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: .75rem 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--desk-ink);
    background: #f1ebe1fa;
    box-shadow: 0 -1.5rem 2rem -1.5rem #f1ebe1;
  }

  .actions p {
    display: flex;
    align-items: center;
    gap: .55rem;
    margin: 0;
    color: var(--desk-muted);
    font-size: .875rem;
    line-height: 1.4;
  }

  .actions p::before {
    flex: none;
    width: .5rem;
    height: .5rem;
    border-radius: 50%;
    background: var(--desk-muted);
    content: "";
  }

  .actions p[data-tone="saved"]::before {
    background: var(--desk-pass);
  }

  .actions p[role="alert"] {
    color: var(--desk-accent);
  }

  .actions p[role="alert"]::before {
    background: var(--desk-accent);
  }

  .checks-column {
    position: sticky;
    top: 5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .actions p {
      animation: tx-rise .45s var(--desk-ease) both;
    }

    .checks-column {
      animation: tx-rise .9s var(--desk-ease) .2s both;
    }
  }

  @media (max-width: 64rem) {
    .editor {
      grid-template-columns: minmax(0, 1fr);
    }

    .checks-column {
      position: static;
    }
  }
</style>

export function DraftEditor({ initial }: { initial: SignalDraft }) {
  let revision = initial.revision;

  const save = $forms((fields: FormData) => {
    const draft: Record<string, unknown> = Object.fromEntries(fields);
    delete draft.target;
    draft.targets = fields.getAll('target');
    const result = saveSignalDraft(revision, draft);

    $track(save).onSuccess(outcome => {
      if (outcome.ok) revision = outcome.draft.revision;
    });

    return result;
  });

  const review = save.result?.ok ? save.result.draft.review : initial.review;

  return (
    <div class="editor">
      <form class="draft-form" onSubmit={save.submit}>
        <TradeDetails fields={initial.fields} />
        <PricePlan fields={initial.fields} />

        <section class="desk-row" aria-labelledby="note-heading">
          <div class="desk-row__head">
            <h2 id="note-heading">"Analyst note"</h2>
            <p>"Optional context for the idea."</p>
          </div>
          <div>
            <textarea name="note" aria-labelledby="note-heading" aria-describedby="note-hint" rows={3} maxlength={500} value={initial.fields.note} />
            <p class="note-hint" id="note-hint">"Up to 500 characters."</p>
          </div>
        </section>

        <div class="actions">
          <button class="desk-button" type="submit" disabled={save.pending}>
            save.pending ? "Saving…" : "Save draft"
          </button>
          if (save.result?.ok) {
            <p role="status" data-tone="saved">"Draft saved. Checks updated."</p>
          } else if (save.result) {
            <p role="alert">save.result.message</p>
          } else if (save.errors.length > 0) {
            <p role="alert">"The draft could not be saved. Check your session and try again."</p>
          } else if (initial.updatedAt) {
            <p role="status">"Saved draft reopened."</p>
          }
        </div>
      </form>

      <div class="checks-column">
        <SignalChecks review={review} />
      </div>
    </div>
  );
}
