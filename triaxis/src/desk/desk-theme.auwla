// Shared desk primitives: tokens, form rows, fields and buttons. Global so every desk component
// can use the same classes, and kept under `.desk` so none of it reaches the public pages.
// Imported once, by `layout/DeskLayout.auwla`. Keyframes come from `home/motion.auwla`.

<style global>
  .desk {
    --desk-ink: #27211d;
    --desk-muted: #625850;
    --desk-rule: #d5cabe;
    --desk-paper: #f1ebe1;
    --desk-surface: #f8f4ec;
    --desk-input: #fffcf6;
    --desk-accent: #a8271c;
    --desk-accent-deep: #8a2119;
    --desk-night: #1b1714;
    --desk-pass: #256448;
    --desk-warn: #815107;
    --desk-mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --desk-ease: cubic-bezier(.16, 1, .3, 1);
    --desk-gutter: clamp(1rem, 4vw, 4rem);
  }

  .desk .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* A status: a coloured dot and its label. */
  .desk .status {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    font-size: .8rem;
    white-space: nowrap;
  }

  .desk .status::before {
    flex: none;
    width: .55rem;
    height: .55rem;
    border-radius: 50%;
    background: var(--status-tone);
    content: "";
  }

  .desk .status[data-status="ready"] { --status-tone: #2f9e64; }
  .desk .status[data-status="rejected"] { --status-tone: var(--desk-accent); }
  .desk .status[data-status="incomplete"] { --status-tone: #c98a00; }
  .desk .status[data-status="posted"] { --status-tone: var(--desk-ink); }

  .desk ::selection {
    background: var(--desk-accent);
    color: #fff9f0;
  }

  /* One numbered section of a form: a heading column beside its fields. */
  .desk-row {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) minmax(0, 1fr);
    gap: 1rem clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 1.75rem 0;
    border: 0;
    border-top: 1px solid var(--desk-rule);
    min-width: 0;
  }

  .desk-row__head h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -.02em;
    counter-increment: desk-section;
  }

  .desk-row__head h2::before {
    display: block;
    margin-bottom: .45rem;
    color: var(--desk-accent);
    font-family: var(--desk-mono);
    font-size: .72rem;
    font-weight: 400;
    content: "0" counter(desk-section);
  }

  .desk-row__head p {
    max-width: 24ch;
    margin: .45rem 0 0;
    color: var(--desk-muted);
    font-size: .82rem;
    line-height: 1.45;
  }

  .desk-label {
    display: grid;
    gap: .5rem;
    min-width: 0;
    color: var(--desk-ink);
    font-size: .82rem;
    font-weight: 500;
  }

  /* Text fields, selects and text areas. Radios and checkboxes keep their native look. */
  .desk input:not([type="radio"], [type="checkbox"]),
  .desk select,
  .desk textarea {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: .85rem 1rem;
    border: 1px solid #d6cbbd;
    border-radius: .75rem;
    background-color: #fffdf9;
    color: var(--desk-ink);
    font: inherit;
    font-size: .95rem;
    font-weight: 400;
    box-shadow: 0 1px 2px #27211d0a, inset 0 1px 0 #ffffff;
    transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
  }

  .desk input:not([type="radio"], [type="checkbox"]),
  .desk select {
    min-height: 3.15rem;
  }

  .desk textarea {
    min-height: 6rem;
    line-height: 1.5;
    resize: vertical;
  }

  .desk input::placeholder,
  .desk textarea::placeholder {
    color: #a89c8e;
  }

  .desk input:not([type="radio"], [type="checkbox"]):hover,
  .desk select:hover,
  .desk textarea:hover {
    border-color: #bcae9e;
    background-color: #ffffff;
  }

  .desk input:not([type="radio"], [type="checkbox"]):focus-visible,
  .desk select:focus-visible,
  .desk textarea:focus-visible {
    border-color: var(--desk-ink);
    outline: none;
    background-color: #ffffff;
    box-shadow: 0 0 0 4px #a8271c1a, 0 1px 2px #27211d14;
  }

  /* A field the person has touched and left wrong. Untouched empty fields stay calm. */
  .desk input:user-invalid,
  .desk textarea:user-invalid {
    border-color: var(--desk-accent);
    box-shadow: 0 0 0 4px #a8271c14;
  }

  /* Read-only fields: a posted analysis, or one another analyst wrote. */
  .desk input:disabled:not([type="radio"], [type="checkbox"]),
  .desk select:disabled,
  .desk textarea:disabled {
    border-color: #e2d9cd;
    background-color: #f5efe6;
    color: var(--desk-muted);
    box-shadow: none;
    cursor: not-allowed;
  }

  /* Prices line up in monospaced figures. */
  .desk input[inputmode="decimal"] {
    font-family: var(--desk-mono);
    font-size: .9rem;
    font-variant-numeric: tabular-nums;
  }

  .desk select {
    padding-right: 2.6rem;
    appearance: none;
    background-image:
      linear-gradient(45deg, #0000 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, #0000 50%);
    background-position:
      right 1.3rem center,
      right 1rem center;
    background-size: .3rem .3rem;
    background-repeat: no-repeat;
    cursor: pointer;
  }

  /* A password field with its Show / Hide button inside it (src/auth/PasswordField.auwla). */
  .desk .password-field {
    position: relative;
    display: block;
  }

  .desk .password-field input {
    padding-right: 4.6rem;
  }

  .desk .password-field button {
    position: absolute;
    top: 50%;
    right: .45rem;
    padding: .4rem .7rem;
    border: 0;
    border-radius: .5rem;
    background: transparent;
    color: var(--desk-muted);
    font: inherit;
    font-size: .78rem;
    font-weight: 500;
    cursor: pointer;
    translate: 0 -50%;
    transition: background-color .2s ease, color .2s ease;
  }

  .desk .password-field button:hover {
    background: #f1ebe1;
    color: var(--desk-ink);
  }

  .desk .password-field button:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: 1px;
  }

  /* The primary action: red, with a little depth. */
  .desk-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    box-sizing: border-box;
    min-height: 2.75rem;
    padding: .6rem 1.3rem;
    border: 1px solid var(--desk-accent);
    border-radius: 999px;
    background: var(--desk-accent);
    color: #fff9f0;
    font: inherit;
    font-size: .9rem;
    font-weight: 500;
    line-height: 1.1;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 1px 2px #27211d1f, inset 0 1px 0 #ffffff1f;
    cursor: pointer;
    transition: background-color .2s ease, border-color .2s ease, color .2s ease, box-shadow .2s ease, scale .3s var(--desk-ease);
  }

  .desk-button:hover {
    border-color: var(--desk-accent-deep);
    background: var(--desk-accent-deep);
    box-shadow: 0 .4rem 1rem -.5rem #8a2119a6, inset 0 1px 0 #ffffff1f;
  }

  .desk-button:active {
    scale: .97;
  }

  .desk-button:disabled {
    opacity: .6;
    box-shadow: none;
    cursor: wait;
  }

  /* A secondary action: a light pill that darkens its edge on hover. */
  .desk-button--quiet {
    min-height: 2.35rem;
    padding: .45rem 1rem;
    border-color: #d6cbbd;
    background: #fffdf9;
    color: var(--desk-ink);
    font-size: .85rem;
    box-shadow: 0 1px 2px #27211d0a;
  }

  .desk-button--quiet:hover {
    border-color: var(--desk-ink);
    background: #ffffff;
    color: var(--desk-ink);
    box-shadow: 0 .35rem .9rem -.55rem #27211d4d;
  }

  .desk-button--quiet:disabled {
    border-color: #e2d9cd;
    background: transparent;
    color: var(--desk-muted);
    opacity: .7;
    box-shadow: none;
    cursor: default;
  }

  .desk-button:focus-visible,
  .desk a:focus-visible,
  .desk summary:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .desk-row {
      animation: tx-rise .8s var(--desk-ease) both;
    }

    .desk-row:nth-of-type(2) {
      animation-delay: .06s;
    }

    .desk-row:nth-of-type(3) {
      animation-delay: .12s;
    }

    .desk-row:nth-of-type(4) {
      animation-delay: .18s;
    }

    .desk-row:nth-of-type(5) {
      animation-delay: .24s;
    }
  }

  /* On a phone the header keeps the signed-in person's initials and drops their name. */
  @media (max-width: 40rem) {
    .desk .identity .badge__text {
      display: none;
    }
  }

  @media (max-width: 48rem) {
    .desk-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .desk-row__head {
      display: flex;
      align-items: baseline;
      gap: .75rem;
    }

    .desk-row__head h2::before {
      display: inline;
      margin-right: .6rem;
    }

    .desk-row__head p {
      display: none;
    }
  }
</style>
