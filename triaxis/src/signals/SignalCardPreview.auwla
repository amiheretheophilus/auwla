import type { SignalReview } from '../desk/draft/model/signal-review';
import { formatSignalTime, type SignalCardData } from './signal-card';

<style>
  /* The card follows the real 1080 x 1080 score card: square, and scaled to its column
     with container units, so the preview is the card in miniature. */
  .frame {
    container-type: inline-size;
  }

  .card {
    --on-night: #f3ede4;
    --muted: #f3ede48c;
    --faint: #f3ede41f;
    --pass: #4fbf7f;
    --loss: #e4614f;
    --warn: #eda100;

    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 4.2cqi;
    aspect-ratio: 1;
    padding: 6.5cqi;
    overflow: hidden;
    border-radius: 1.6cqi;
    background: #0d0b0a;
    color: var(--on-night);
    font-family: "Helvetica Neue", Arial, sans-serif;
  }

  .card[data-axis="forex"] { --accent: #3987e5; }
  .card[data-axis="crypto"] { --accent: #9085e9; }
  .card[data-axis="synthetics"] { --accent: #eda100; }

  /* A hairline of the axis colour across the top, and the faint TRIAXIS watermark. */
  .card::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: .9cqi;
    background: var(--accent);
    content: "";
  }

  .card::after {
    position: absolute;
    inset: -20% -60%;
    z-index: -1;
    color: #f3ede4;
    font-size: 5.4cqi;
    font-weight: 800;
    line-height: 2.3;
    letter-spacing: .5em;
    white-space: pre;
    content: "TRIAXIS TRIAXIS TRIAXIS TRIAXIS TRIAXIS\A    TRIAXIS TRIAXIS TRIAXIS TRIAXIS TRIAXIS\A TRIAXIS TRIAXIS TRIAXIS TRIAXIS TRIAXIS\A    TRIAXIS TRIAXIS TRIAXIS TRIAXIS TRIAXIS\A TRIAXIS TRIAXIS TRIAXIS TRIAXIS TRIAXIS\A    TRIAXIS TRIAXIS TRIAXIS TRIAXIS TRIAXIS\A TRIAXIS TRIAXIS TRIAXIS TRIAXIS TRIAXIS\A    TRIAXIS TRIAXIS TRIAXIS TRIAXIS TRIAXIS";
    opacity: .028;
    rotate: -24deg;
    pointer-events: none;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3cqi;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 2.2cqi;
    font-size: 3.6cqi;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  /* The three-bar mark, as in the site header. */
  .mark {
    position: relative;
    width: 4.4cqi;
    height: 4.4cqi;
  }

  .mark i {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: .7cqi;
    background: var(--on-night);
  }

  .mark i:nth-child(1) { background: #c8392b; rotate: 60deg; }
  .mark i:nth-child(2) { rotate: -60deg; }

  .tag {
    color: var(--accent);
    font-family: var(--desk-mono);
    font-size: 2.7cqi;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .asset {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 3cqi;
  }

  .asset h3 {
    margin: 0;
    font-size: 12cqi;
    font-weight: 700;
    line-height: .88;
    letter-spacing: -.045em;
  }

  .asset p {
    margin: 2cqi 0 0;
    color: var(--muted);
    font-size: 3.1cqi;
  }

  .side {
    padding: 1.6cqi 3.4cqi;
    border-radius: 1cqi;
    background: var(--pass);
    color: #0d0b0a;
    font-family: var(--desk-mono);
    font-size: 3.4cqi;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .side[data-side="sell"] {
    background: var(--loss);
  }

  /* Levels beside a ladder that places each one at its real price. */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7cqi;
    gap: 4cqi;
    min-height: 0;
    padding-block: 3cqi;
    border-block: 1px solid var(--faint);
  }

  .levels {
    display: grid;
    align-content: space-between;
    gap: 1.4cqi;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .level {
    display: grid;
    grid-template-columns: 11cqi minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 2cqi;
    font-family: var(--desk-mono);
  }

  .level span:first-child {
    color: var(--muted);
    font-size: 2.6cqi;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .level strong {
    overflow: hidden;
    font-size: 4.2cqi;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .level em {
    color: var(--pass);
    font-size: 2.8cqi;
    font-style: normal;
  }

  .level[data-kind="stop"] em {
    color: var(--loss);
  }

  .level[data-kind="entry"] strong {
    color: #fff;
  }

  .ladder {
    position: relative;
    margin-block: 1.2cqi;
  }

  .ladder::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--faint);
    content: "";
  }

  .zone {
    position: absolute;
    left: calc(50% - .6cqi);
    width: 1.2cqi;
    border-radius: .6cqi;
  }

  .zone[data-kind="risk"] { background: var(--loss); }
  .zone[data-kind="reward"] { background: var(--pass); }

  .tick {
    position: absolute;
    left: 50%;
    width: 3cqi;
    height: 3cqi;
    border: .6cqi solid #0d0b0a;
    border-radius: 50%;
    background: var(--pass);
    translate: -50% -50%;
  }

  .tick[data-kind="stop"] { background: var(--loss); }
  .tick[data-kind="entry"] { background: #fff; }

  /* The checks the card was posted with. */
  .checks {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6cqi 4cqi;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .check {
    display: inline-flex;
    align-items: center;
    gap: 1.6cqi;
    font-size: 2.9cqi;
  }

  .check::before {
    display: grid;
    place-items: center;
    width: 3.6cqi;
    height: 3.6cqi;
    border-radius: 50%;
    background: var(--mark);
    color: #0d0b0a;
    font-size: 2.3cqi;
    font-weight: 800;
    content: var(--glyph);
    transition: background-color .3s ease;
  }

  .check[data-status="pass"] { --mark: var(--pass); --glyph: "✓"; }
  .check[data-status="warning"] { --mark: var(--warn); --glyph: "!"; }
  .check[data-status="fail"] { --mark: var(--loss); --glyph: "✕"; }
  .check[data-status="pending"] { --mark: #f3ede433; --glyph: ""; color: var(--muted); }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 3cqi;
  }

  .foot__id {
    display: grid;
    gap: .8cqi;
    font-family: var(--desk-mono);
  }

  .foot__id strong {
    font-size: 3.6cqi;
    font-weight: 600;
    letter-spacing: .06em;
  }

  .foot__id span,
  .disclaimer {
    color: var(--muted);
    font-size: 2.4cqi;
    letter-spacing: .04em;
  }

  .seal {
    padding: 1.4cqi 2.4cqi;
    border: 1px solid var(--on-night);
    border-radius: .8cqi;
    font-size: 2.3cqi;
    font-weight: 700;
    letter-spacing: .14em;
    text-align: center;
    text-transform: uppercase;
  }

  .card[data-posted="false"] .seal {
    border-style: dashed;
    border-color: var(--muted);
    color: var(--muted);
  }

  .disclaimer {
    position: absolute;
    right: 6.5cqi;
    bottom: 2.4cqi;
    left: 6.5cqi;
    margin: 0;
    font-size: 2cqi;
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tick,
    .zone {
      transition: top .4s cubic-bezier(.16, 1, .3, 1), height .4s cubic-bezier(.16, 1, .3, 1);
    }
  }
</style>

const axisNumbers: Record<string, string> = { forex: '1', crypto: '2', synthetics: '3' };

function amount(value: string): number | null {
  const parsed = Number(value);
  return value.trim() !== '' && Number.isFinite(parsed) ? parsed : null;
}

interface Level {
  key: string;
  kind: 'stop' | 'entry' | 'target';
  label: string;
  price: string;
  note: string;
  value: number | null;
}

/** The distance from entry to the stop, or 0 until both are numbers. */
function riskOf(entry: number | null, stop: number | null): number {
  if (entry === null || stop === null) {
    return 0;
  }
  return Math.abs(entry - stop);
}

/** How far a target sits from entry, in stop distances: "2.0×", or '' until it can be worked out. */
function targetNote(value: number | null, entry: number | null, risk: number): string {
  if (value === null || entry === null || risk <= 0) {
    return '';
  }
  return (Math.abs(value - entry) / risk).toFixed(1) + '×';
}

/** The stop's distance below or above entry: "−10". */
function stopNote(risk: number): string {
  if (risk <= 0) {
    return '';
  }
  return '−' + Number(risk.toPrecision(6));
}

/** Stop, entry and targets, with each target's distance from entry in stop distances. */
function levelsOf(card: SignalCardData): Level[] {
  const entry = amount(card.entry);
  const stop = amount(card.stop);
  const risk = riskOf(entry, stop);

  const targets = card.targets.map((price, index): Level => {
    const value = amount(price);
    return { key: 'tp' + index, kind: 'target', label: 'TP' + (index + 1), price, note: targetNote(value, entry, risk), value };
  });

  const levels: Level[] = [
    ...targets,
    { key: 'entry', kind: 'entry', label: 'Entry', price: card.entry, note: '', value: entry },
    { key: 'stop', kind: 'stop', label: 'Stop', price: card.stop, note: stopNote(risk), value: stop },
  ];

  // Highest price at the top, as on a chart. Until every price is a number, keep the plan's order.
  if (levels.some(level => level.value === null)) {
    return levels;
  }
  return [...levels].sort((a, b) => b.value! - a.value!);
}

/** The target furthest from entry, where the reward zone ends. */
function furthestTarget(targets: number[], entry: number): number {
  let furthest = entry;
  for (const value of targets) {
    if (Math.abs(value - entry) > Math.abs(furthest - entry)) {
      furthest = value;
    }
  }
  return furthest;
}

/** "Buy"/"Long" is the buy side, "Sell"/"Short" the sell side, '' while no direction is chosen. */
function sideOf(direction: string): 'buy' | 'sell' | '' {
  if (direction === 'Buy' || direction === 'Long') {
    return 'buy';
  }
  if (direction) {
    return 'sell';
  }
  return '';
}

/** "Market entry", or a prompt while no entry type is chosen. */
function entryTypeLabel(entryType: string): string {
  if (!entryType) {
    return 'Entry type not set';
  }
  return entryType.charAt(0).toUpperCase() + entryType.slice(1) + ' entry';
}

/** Where each level sits on the ladder, from the top, or null until every price is a number. */
function ladderOf(levels: Level[]) {
  if (levels.some(level => level.value === null)) return null;
  const values = levels.map(level => level.value!);
  const high = Math.max(...values);
  const low = Math.min(...values);
  if (high === low) return null;
  const at = (value: number) => ((high - value) / (high - low)) * 100;
  const entry = levels.find(level => level.kind === 'entry')!.value!;
  const stop = levels.find(level => level.kind === 'stop')!.value!;
  const targets = levels.filter(level => level.kind === 'target').map(level => level.value!);
  const furthest = furthestTarget(targets, entry);
  const span = (a: number, b: number) => ({ top: Math.min(at(a), at(b)) + '%', height: Math.abs(at(a) - at(b)) + '%' });
  return {
    ticks: levels.map(level => ({ key: level.key, kind: level.kind, top: at(level.value!) + '%' })),
    risk: span(entry, stop),
    reward: span(entry, furthest),
  };
}

interface PreviewProps {
  card: SignalCardData;
  review: SignalReview;
  signalId: string | null;
  publishedAt: string | null;
}

/** The score card as members will see it. Before posting it carries a draft seal. */
export function SignalCardPreview({ card, review, signalId, publishedAt }: PreviewProps) {
  const levels = levelsOf(card);
  const ladder = ladderOf(levels);
  const side = sideOf(card.direction);
  const entryType = entryTypeLabel(card.entryType);
  const posted = signalId !== null && publishedAt !== null;

  return (
    <div class="frame">
      <article class="card" data-axis={card.axis} data-posted={String(posted)} aria-label={posted ? 'Signal card ' + signalId : 'Score card preview'}>
        <header class="top">
          <span class="brand"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>"Triaxis"</span>
          <span class="tag">"Axis " + (axisNumbers[card.axis] ?? '') + " · " + card.market</span>
        </header>

        <div class="asset">
          <div>
            <h3>card.symbol || "Asset"</h3>
            <p>card.market + " · " + entryType</p>
          </div>
          if (side) {
            <span class="side" data-side={side}>card.direction</span>
          }
        </div>

        <div class="body">
          <ol class="levels">
            for (const level of levels) {
              <li key={level.key} class="level" data-kind={level.kind}>
                <span>level.label</span>
                <strong>level.price || "—"</strong>
                <em>level.note</em>
              </li>
            }
          </ol>
          if (ladder) {
            <div class="ladder" aria-hidden="true">
              <span class="zone" data-kind="reward" style={ladder.reward}></span>
              <span class="zone" data-kind="risk" style={ladder.risk}></span>
              for (const tick of ladder.ticks) {
                <span key={tick.key} class="tick" data-kind={tick.kind} style={{ top: tick.top }}></span>
              }
            </div>
          } else {
            <div class="ladder" aria-hidden="true"></div>
          }
        </div>

        <ul class="checks" aria-label="Checks">
          for (const check of review.checks) {
            <li key={check.label} class="check" data-status={check.status}>check.label</li>
          }
        </ul>

        <footer class="foot">
          <div class="foot__id">
            <strong>posted ? signalId : "TRX-····"</strong>
            <span>posted ? formatSignalTime(publishedAt!) : "Not posted yet"</span>
          </div>
          <span class="seal">posted ? "Official Triaxis signal" : "Draft · not posted"</span>
        </footer>
        <p class="disclaimer">"Not financial advice. Trading involves risk."</p>
      </article>
    </div>
  );
}
