import '../desk/desk-theme.auwla';

<style>
  body {
    margin: 0;
  }

  .desk {
    min-height: 100vh;
    background: var(--desk-paper);
    color: var(--desk-ink);
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-synthesis: none;
    -webkit-font-smoothing: antialiased;
  }

  /* The photograph on one side, the form on the other. */
  .auth-page {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    min-height: calc(100svh - 3.65rem);
  }

  .auth-art {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 4rem) var(--desk-gutter);
    overflow: hidden;
    background: #e8d9c6;
  }

  .auth-art img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }

  .auth-art::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, #eae0d2 0%, #eae0d2cc 22%, #eae0d200 60%),
      linear-gradient(90deg, #eee5d7aa 0%, #eee5d700 55%);
    content: "";
  }

  .auth-art h1 {
    display: flex;
    flex-wrap: wrap;
    column-gap: .2em;
    margin: 0;
    font-size: clamp(3rem, 7.5vw, 8rem);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.07em;
  }

  .word {
    display: block;
    overflow: hidden;
    padding-bottom: .1em;
    margin-bottom: -.1em;
  }

  .word span {
    display: block;
  }

  .auth-art p {
    max-width: 34ch;
    margin: 0;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.35;
    letter-spacing: -.02em;
  }

  .auth-panel {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 5rem) var(--desk-gutter);
    background: var(--desk-surface);
    border-left: 1px solid var(--desk-rule);
  }

  .auth-panel__intro h2 {
    margin: 0;
    font-size: clamp(1.75rem, 2.8vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -.05em;
  }

  .auth-panel__intro p {
    max-width: 34ch;
    margin: .6rem 0 0;
    color: var(--desk-muted);
    line-height: 1.5;
  }

  .risk-note {
    width: min(100%, 24rem);
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--desk-rule);
    color: var(--desk-muted);
    font-size: .8rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .word span {
      animation: tx-word 1.1s var(--desk-ease) both;
    }

    .word:nth-child(2) span {
      animation-delay: .12s;
    }

    .auth-art img {
      animation: tx-settle 1.8s var(--desk-ease) both;
    }

    .auth-art p {
      animation: tx-rise 1s var(--desk-ease) .3s both;
    }

    .auth-panel > * {
      animation: tx-rise .9s var(--desk-ease) both;
    }

    .auth-panel > :nth-child(2) {
      animation-delay: .1s;
    }

    .auth-panel > :nth-child(3) {
      animation-delay: .2s;
    }
  }

  @media (max-width: 52rem) {
    .auth-page {
      grid-template-columns: minmax(0, 1fr);
    }

    .auth-art {
      min-height: 15rem;
    }

    .auth-panel {
      align-content: start;
      border-left: 0;
      border-top: 1px solid var(--desk-rule);
    }
  }
</style>

interface AuthSplitProps {
  /** The two words of the large heading over the photograph. */
  first: string;
  second: string;
  lede: string;
  title: string;
  text: string;
}

/**
 * A sign-in or sign-up page: the photograph and a large heading on one side, the form on the
 * other. The page's header goes in the `header` slot and the form in the default slot.
 */
export function AuthSplit({ first, second, lede, title, text }: AuthSplitProps) {
  return (
    <div class="desk">
      <slot name="header" />
      <main class="auth-page">
        <section class="auth-art" aria-labelledby="auth-heading">
          <img src="/images/market-axes.webp" alt="" width={1536} height={1024} />
          <h1 id="auth-heading">
            <span class="word"><span>first</span></span>
            <span class="word"><span>second</span></span>
          </h1>
          <p>lede</p>
        </section>

        <section class="auth-panel" aria-labelledby="auth-panel-heading">
          <div class="auth-panel__intro">
            <h2 id="auth-panel-heading">title</h2>
            <p>text</p>
          </div>
          <slot />
          <p class="risk-note">"Trading involves risk. Signals are for informational purposes only and are not financial advice."</p>
        </section>
      </main>
    </div>
  );
}
