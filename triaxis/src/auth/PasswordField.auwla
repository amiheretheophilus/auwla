interface PasswordFieldProps {
  label: string;
  autocomplete: 'current-password' | 'new-password';
  id?: string;
  minLength?: number;
  describedBy?: string;
}

/**
 * A labelled password field with a Show / Hide button inside it, so a member can check what they
 * typed. Styled by the shared theme (`.password-field` in desk-theme.auwla).
 */
export function PasswordField({ label, autocomplete, id, minLength, describedBy }: PasswordFieldProps) {
  let shown = false;

  let inputType = 'password';
  let toggleText = 'Show';
  let toggleLabel = 'Show password';
  if (shown) {
    inputType = 'text';
    toggleText = 'Hide';
    toggleLabel = 'Hide password';
  }

  return (
    <label class="desk-label" for=id>
      label
      <span class="password-field">
        <input id=id name="password" type=inputType autocomplete=autocomplete minlength=minLength
          maxlength={128} required aria-describedby=describedBy />
        <button type="button" aria-pressed=shown aria-label=toggleLabel
          onClick={() => shown = !shown}>toggleText</button>
      </span>
    </label>
  );
}
