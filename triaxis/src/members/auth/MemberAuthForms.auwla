import { navigate } from '@memoized-dom/router';
import { memberLogin, signUp } from '#server-functions';
import { AuthForm } from './AuthForm.auwla';
import { PasswordField } from '../../auth/PasswordField.auwla';

<style>
  .hint {
    margin: -.6rem 0 0;
    color: var(--desk-muted);
    font-size: .78rem;
  }

  /* The link to the other form. It is slotted into AuthForm, so its style lives here. */
  .switch-link {
    color: var(--desk-accent);
    text-underline-offset: .2em;
  }
</style>

/** The first error a member form has to show, or ''. */
function formError(failed: boolean, message: string | undefined, fallback: string): string {
  if (!failed) {
    return '';
  }
  return message ?? fallback;
}

/** `?plan=` for the plan a visitor picked on the pricing page, or no query. */
function planQuery(plan: string): Record<string, string> {
  if (plan) {
    return { plan };
  }
  return {};
}

export function MemberSignInForm({ plan }: { plan: string }) {
  const form = $forms(async (fields: FormData) => {
    const signedIn = await memberLogin(String(fields.get('email') ?? '').trim(), String(fields.get('password') ?? ''));

    // Staff open the desk. A member who picked a plan carries on to pay for it; any other
    // member goes to their signals.
    if (signedIn.staff) {
      navigate('/desk', { replace: true });
    } else if (plan) {
      navigate('/subscribe', { replace: true, query: planQuery(plan) });
    } else {
      navigate('/signals', { replace: true });
    }
    return signedIn;
  });

  const error = formError(form.errors.length > 0, form.errors[0]?.message, 'Sign-in failed. Try again.');

  return (
    <AuthForm submit={form.submit} pending={form.pending} action="Sign in" pendingAction="Signing in…" error=error>
      <label class="desk-label">
        "Email"
        <input name="email" type="email" autocomplete="username" maxlength={254} placeholder="you@example.com" required />
      </label>
      <PasswordField label="Password" autocomplete="current-password" id="member-password" />
      <span slot="switch">"New to Triaxis? " <a class="switch-link" route-to={{ path: '/sign-up', query: planQuery(plan) }}>"Create an account"</a></span>
    </AuthForm>
  );
}

export function MemberSignUpForm({ plan }: { plan: string }) {
  const form = $forms(async (fields: FormData) => {
    const signedUp = await signUp(
      String(fields.get('name') ?? '').trim(),
      String(fields.get('email') ?? '').trim(),
      String(fields.get('password') ?? ''),
    );
    navigate('/subscribe', { replace: true, query: planQuery(plan) });
    return signedUp;
  });

  const error = formError(form.errors.length > 0, form.errors[0]?.message, 'Sign-up failed. Try again.');

  return (
    <AuthForm submit={form.submit} pending={form.pending} action="Create account" pendingAction="Creating account…" error=error>
      <label class="desk-label">
        "Full name"
        <input name="name" autocomplete="name" minlength={2} maxlength={80} placeholder="Ama Mensah" required />
      </label>
      <label class="desk-label">
        "Email"
        <input name="email" type="email" autocomplete="email" maxlength={254} placeholder="you@example.com" required />
      </label>
      <PasswordField label="Password" autocomplete="new-password" id="new-password" minLength={12} describedBy="password-hint" />
      <p class="hint" id="password-hint">"At least 12 characters."</p>
      <span slot="switch">"Already a member? " <a class="switch-link" route-to={{ path: '/sign-in', query: planQuery(plan) }}>"Sign in"</a></span>
    </AuthForm>
  );
}
