import { formatDay, paymentStatusLabels, type AxisAccess, type MemberHome } from '../membership';
import { axisLabel, findPlan, planLength, planTitle } from '../plans';
import { formatSignalTime, levelsText, type PublishedSignal } from '../../signals/signal-card';
import { SignalEntry } from './SignalEntry.auwla';

<style>
  .title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .title .kicker {
    margin: 0 0 .75rem;
    color: var(--desk-accent);
    font-weight: 500;
  }

  .title h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5.5vw, 5rem);
    font-weight: 400;
    line-height: .92;
    letter-spacing: -.07em;
  }

  .title p {
    max-width: 34ch;
    margin: 0;
    color: var(--desk-muted);
    font-size: .875rem;
    line-height: 1.5;
  }

  /* The three axes, held or locked, in ruled columns like the public page. */
  .axes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 1.5rem;
    padding: 0;
    border-block: 1px solid var(--desk-ink);
    list-style: none;
  }

  .axis {
    display: grid;
    align-content: start;
    gap: .55rem;
    padding: 1.25rem clamp(1rem, 2.5vw, 2rem);
    border-left: 1px solid var(--desk-rule);
  }

  .axis:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .axis[data-axis="forex"] { --axis-color: #3987e5; }
  .axis[data-axis="crypto"] { --axis-color: #9085e9; }
  .axis[data-axis="synthetics"] { --axis-color: #eda100; }

  .axis h2 {
    display: flex;
    align-items: center;
    gap: .55rem;
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 400;
    letter-spacing: -.045em;
  }

  .axis h2::before {
    width: .55rem;
    height: .55rem;
    border-radius: 50%;
    background: var(--axis-color);
    content: "";
  }

  .axis p {
    margin: 0;
    color: var(--desk-muted);
    font-size: .85rem;
  }

  .axis[data-active="true"] p {
    color: var(--desk-pass);
  }

  /* A locked axis's way in: a quiet text link, not another button. */
  .unlock {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: .4rem;
    margin-top: .3rem;
    padding-bottom: .15rem;
    border-bottom: 1px solid currentColor;
    color: var(--desk-ink);
    font-size: .88rem;
    font-weight: 500;
    text-decoration: none;
    transition: color .2s ease;
  }

  .unlock span {
    transition: translate .3s var(--desk-ease);
  }

  .unlock:hover {
    color: var(--desk-accent);
  }

  .unlock:hover span {
    translate: .25rem 0;
  }

  .unlock:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: 3px;
  }

  .notice {
    margin: 0 0 1.5rem;
    padding: .85rem 1rem;
    border-left: 2px solid #c98a00;
    background: var(--desk-surface);
    font-size: .875rem;
    line-height: 1.45;
  }

  .notice[data-status="rejected"] {
    border-left-color: var(--desk-accent);
  }

  /* The feed. */
  .feed-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: .75rem 1.5rem;
    margin: 2rem 0 0;
    border-bottom: 1px solid var(--desk-rule);
  }

  .feed-head h2 {
    margin: 0;
    padding-bottom: .8rem;
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: -.035em;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tab {
    position: relative;
    padding: .7rem 0 .8rem;
    margin-left: 1.1rem;
    border: 0;
    background: none;
    color: var(--desk-muted);
    font: inherit;
    font-size: .9rem;
    cursor: pointer;
  }

  .tab::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--desk-ink);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .4s var(--desk-ease);
  }

  .tab[aria-pressed="true"] {
    color: var(--desk-ink);
  }

  .tab[aria-pressed="true"]::after {
    transform: scaleX(1);
  }

  .tab:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: 2px;
  }

  .latest {
    border-bottom: 1px solid var(--desk-rule);
  }

  /* Older signals: one ruled row each, opened in place. */
  .earlier-head {
    margin: 2.25rem 0 0;
    padding-bottom: .7rem;
    border-bottom: 1px solid var(--desk-ink);
    color: var(--desk-muted);
    font-size: .8rem;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .earlier {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .older {
    border-bottom: 1px solid var(--desk-rule);
  }

  .older summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: .9rem;
    padding: 1rem 0;
    list-style: none;
    cursor: pointer;
  }

  .older summary::-webkit-details-marker {
    display: none;
  }

  .older summary::before {
    width: .5rem;
    height: .5rem;
    border-radius: 50%;
    background: var(--axis-color);
    content: "";
  }

  .older[data-axis="forex"] { --axis-color: #3987e5; }
  .older[data-axis="crypto"] { --axis-color: #9085e9; }
  .older[data-axis="synthetics"] { --axis-color: #eda100; }

  .older strong {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -.015em;
  }

  .older time {
    color: var(--desk-muted);
    font-family: var(--desk-mono);
    font-size: .75rem;
  }

  /* A plus that turns into a minus while the row is open. */
  .older__toggle {
    position: relative;
    width: .8rem;
    height: .8rem;
  }

  .older__toggle::before,
  .older__toggle::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--desk-ink);
    content: "";
    translate: 0 -50%;
    transition: rotate .3s var(--desk-ease);
  }

  .older__toggle::after {
    rotate: 90deg;
  }

  .older[open] .older__toggle::after {
    rotate: 0deg;
  }

  .older summary:hover strong {
    color: var(--desk-accent);
  }

  .older summary:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: 2px;
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: .9rem;
    padding: 2.5rem 0;
  }

  .empty h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -.04em;
  }

  .empty p {
    max-width: 44ch;
    margin: 0;
    color: var(--desk-muted);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .axis {
      animation: tx-rise .6s var(--desk-ease) both;
    }

    .axis:nth-child(2) { animation-delay: .06s; }
    .axis:nth-child(3) { animation-delay: .12s; }
  }

  @media (max-width: 52rem) {
    .axes {
      grid-template-columns: minmax(0, 1fr);
    }

    .axis {
      padding: 1rem 0;
      border-left: 0;
    }

    .axis + .axis {
      border-top: 1px solid var(--desk-rule);
    }

    .older summary {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .older time {
      grid-row: 2;
      grid-column: 2;
    }
  }
</style>

/** "Active until 18 Dec 2026", "Lifetime access" or "Locked". */
function accessLine(entry: AxisAccess): string {
  if (!entry.active) {
    return 'Locked';
  }
  if (entry.expiresAt === null) {
    return 'Lifetime access';
  }
  return 'Active until ' + formatDay(entry.expiresAt);
}

/** "One axis · 1 month (Forex)" for a payment's plan. */
function paymentPlanLabel(planId: string, axes: string[]): string {
  const plan = findPlan(planId);
  const covered = axes.map(axisLabel).join(', ');
  if (!plan) {
    return covered;
  }
  return `${planTitle(plan)} · ${planLength(plan)} (${covered})`;
}

export function MemberDashboard({ home }: { home: MemberHome }) {
  let axisFilter = 'all';
  let copiedId = '';

  const held = home.access.filter(entry => entry.active);
  const firstName = home.member.name.split(' ')[0] ?? home.member.name;
  // Signals arrive newest first. The newest is shown in full; the earlier ones wait folded.
  const visible = home.signals.filter(signal => axisFilter === 'all' || signal.card.axis === axisFilter);
  const latest = visible[0];
  const earlier = visible.slice(1);
  const latestPayment = home.payments.find(payment => payment.status !== 'approved');

  function copyLevels(signal: PublishedSignal) {
    void navigator.clipboard?.writeText(levelsText(signal.card)).then(() => {
      copiedId = signal.id;
    });
  }

  return (
    <section aria-labelledby="home-heading">
      <div class="title">
        <div>
          <p class="kicker">"Your signals"</p>
          <h1 id="home-heading">"Welcome, " + firstName</h1>
        </div>
        <p>"Signals appear here for the axes you hold. A locked axis stays visible, ready to add."</p>
      </div>

      <ul class="axes" aria-label="Your axes">
        for (const entry of home.access) {
          <li key={entry.axis} class="axis" data-axis={entry.axis} data-active={String(entry.active)}>
            <h2>entry.label</h2>
            <p>accessLine(entry)</p>
            if (!entry.active) {
              <a class="unlock" route-to={{ path: '/subscribe', query: { plan: 'single-1m', axis: entry.axis } }}>
                "Unlock " + entry.label <span aria-hidden="true">"→"</span>
              </a>
            }
          </li>
        }
      </ul>

      if (latestPayment && latestPayment.status === 'pending') {
        <p class="notice" data-status="pending">"Your payment for " + paymentPlanLabel(latestPayment.planId, latestPayment.axes) + " (reference " + latestPayment.reference + ") is " + paymentStatusLabels.pending.toLowerCase() + ". Access starts when an admin approves it."</p>
      } else if (latestPayment && latestPayment.status === 'rejected') {
        <p class="notice" data-status="rejected">"Your payment " + latestPayment.reference + " was not approved. Check the reference and submit it again, or contact Triaxis."</p>
      }

      <div class="feed-head">
        <h2>"Signal feed"</h2>
        if (held.length > 1) {
          <ul class="tabs" aria-label="Filter by axis">
            <li><button class="tab" type="button" aria-pressed={axisFilter === 'all'} onClick={() => axisFilter = 'all'}>"All"</button></li>
            for (const entry of held) {
              <li key={entry.axis}>
                <button class="tab" type="button" aria-pressed={axisFilter === entry.axis} onClick={() => axisFilter = entry.axis}>entry.label</button>
              </li>
            }
          </ul>
        }
      </div>

      if (held.length === 0) {
        <div class="empty">
          <h3>"No axes yet"</h3>
          <p>"Unlock an axis above, and its signals appear here as soon as they are posted."</p>
        </div>
      } else if (latest) {
        <div class="latest">
          <SignalEntry signal={latest} copied={copiedId === latest.id} onCopy={copyLevels} />
        </div>
        if (earlier.length > 0) {
          <h3 class="earlier-head">"Earlier signals · " + earlier.length</h3>
          <ul class="earlier" aria-label="Earlier signals">
            for (const signal of earlier) {
              <li key={signal.id}>
                <details class="older" data-axis={signal.card.axis}>
                  <summary>
                    <strong>signal.card.symbol + " · " + signal.card.direction</strong>
                    <time datetime={signal.publishedAt}>signal.id + " · " + formatSignalTime(signal.publishedAt)</time>
                    <span class="older__toggle" aria-hidden="true"></span>
                  </summary>
                  <SignalEntry signal={signal} copied={copiedId === signal.id} onCopy={copyLevels} />
                </details>
              </li>
            }
          </ul>
        }
      } else {
        <div class="empty">
          <h3>"No signals yet"</h3>
          <p>"New signals on your axes appear here as soon as an analyst posts them."</p>
        </div>
      }
    </section>
  );
}
