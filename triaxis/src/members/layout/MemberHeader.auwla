import { route } from '@memoized-dom/router';
import type { Member } from '../membership';
import { Wordmark } from '../../brand/Wordmark.auwla';
import { StaffBadge } from '../../desk/StaffBadge.auwla';

<style>
  .member-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.65rem;
    padding-inline: var(--desk-gutter);
    border-bottom: 1px solid var(--desk-rule);
    background: #f1ebe1e6;
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  /* The nav fills the header's height, so a link's bar can sit on the header's bottom edge. */
  .member-header nav {
    display: flex;
    align-self: stretch;
    align-items: stretch;
    gap: clamp(1rem, 2.4vw, 1.75rem);
    margin-left: auto;
    font-size: .875rem;
  }

  .account {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .account form {
    margin: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--desk-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color .2s ease;
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: var(--desk-ink);
    content: "";
    transform: scaleX(0);
    transition: transform .35s var(--desk-ease);
  }

  .nav-link:hover {
    color: var(--desk-ink);
  }

  /* The page being shown. */
  .nav-link[aria-current="page"] {
    color: var(--desk-ink);
    font-weight: 500;
  }

  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--desk-ink);
    outline-offset: -2px;
  }

  .identity {
    padding-left: clamp(.75rem, 2vw, 1.5rem);
    border-left: 1px solid var(--desk-rule);
  }

  /* On a phone the links get a row of their own under the wordmark, which scrolls sideways
     when they don't fit, so every page stays one tap away. */
  @media (max-width: 40rem) {
    .member-header {
      flex-wrap: wrap;
      row-gap: 0;
    }

    .account {
      margin-left: auto;
    }

    .identity {
      padding-left: 0;
      border-left: 0;
    }

    .member-header nav {
      order: 1;
      flex-basis: 100%;
      min-height: 2.75rem;
      margin-inline: calc(-1 * var(--desk-gutter));
      padding-inline: var(--desk-gutter);
      overflow-x: auto;
      border-top: 1px solid var(--desk-rule);
    }
  }
</style>

/** `aria-current="page"` for the link to the page being shown, so it is marked and announced. */
function currentPage(isCurrent: boolean): 'page' | undefined {
  if (isCurrent) {
    return 'page';
  }
  return undefined;
}

/**
 * The member area's header: the member and their pages, or sign-in links for a visitor.
 * Staff get the desk's own links here too (the same ones `DeskHeader` shows), so an admin
 * reaches Payments from any page in one click. Admins hold every axis for life, so they get
 * no Plans link.
 */
export function MemberHeader({ member }: { member: Member | null }) {
  const path = route.pathname;
  const onSignals = path === '/signals';
  const onPlans = path === '/pricing' || path === '/subscribe';

  return (
    <header class="member-header">
      if (member) {
        <Wordmark href="/" label="Triaxis home" area="Members" />
      } else {
        <Wordmark href="/" label="Triaxis home" />
      }
      <nav aria-label="Member navigation">
        if (member) {
          if (member.staffRole) {
            <a class="nav-link" href="/desk">"Analyses"</a>
            if (member.staffRole === 'admin') {
              <a class="nav-link" href="/desk/payments">"Payments"</a>
            }
          }
          <a class="nav-link" route-to="/signals" aria-current={currentPage(onSignals)}>"Signals"</a>
          if (member.staffRole !== 'admin') {
            <a class="nav-link" route-to="/pricing" aria-current={currentPage(onPlans)}>"Plans"</a>
          }
        } else {
          <a class="nav-link" route-to="/pricing" aria-current={currentPage(path === '/pricing')}>"Pricing"</a>
          <a class="nav-link" route-to="/sign-in" aria-current={currentPage(path === '/sign-in')}>"Sign in"</a>
        }
      </nav>
      <div class="account">
        if (member) {
          if (member.staffRole) {
            <span class="identity"><StaffBadge member={{ id: member.id, name: member.name, role: member.staffRole }} role={true} /></span>
          } else {
            <span class="identity"><StaffBadge member={{ id: member.id, name: member.name, role: 'analyst' }} /></span>
          }
          <form method="post" action="/sign-out">
            <button class="desk-button desk-button--quiet" type="submit">"Sign out"</button>
          </form>
        } else {
          <a class="desk-button" route-to="/pricing">"Get started"</a>
        }
      </div>
    </header>
  );
}
