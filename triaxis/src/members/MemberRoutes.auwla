import { redirectRoute } from '@memoized-dom/router';
import { accessFor, getMember, signalsFor } from '#server/members/access';
import { listMemberPayments, paymentInstructions } from '#server/members/payments';
import { AuthSplit } from '../auth/AuthSplit.auwla';
import { findPlan, plansOnSale } from './plans';
import { PricingPage } from '../pricing/PricingPage.auwla';
import { MemberSignInForm, MemberSignUpForm } from './auth/MemberAuthForms.auwla';
import { MemberDashboard } from './home/MemberDashboard.auwla';
import { MemberHeader } from './layout/MemberHeader.auwla';
import { MemberShell } from './layout/MemberShell.auwla';
import { SubscribePage } from './subscribe/SubscribePage.auwla';

/** The plan a visitor picked on the pricing page (`?plan=`), or '' when there is none or it is not on sale. */
function chosenPlan(query: { get(name: string): string | null }): string {
  const id = query.get('plan') ?? '';
  if (findPlan(id)) {
    return id;
  }
  return '';
}

/** The axis a single-axis plan was opened for (`?axis=`), or ''. */
function chosenAxis(query: { get(name: string): string | null }): string {
  const axis = query.get('axis') ?? '';
  if (axis === 'forex' || axis === 'crypto' || axis === 'synthetics') {
    return axis;
  }
  return '';
}

/** Where a member goes once signed in: checkout with their plan picked, or their signals. */
function afterSignIn(plan: string): string {
  if (plan) {
    return `/subscribe?plan=${encodeURIComponent(plan)}`;
  }
  return '/signals';
}

/** The sign-in page, keeping the plan a visitor picked. */
function signInFor(plan: string): string {
  if (plan) {
    return `/sign-in?plan=${encodeURIComponent(plan)}`;
  }
  return '/sign-in';
}

/** `/pricing`: the plans, for visitors and members alike. */
export function PricingRoute() {
  const page = $routed(async ({ request }) => {
    const signedIn = await getMember(request);
    if (signedIn) {
      return { member: signedIn.member };
    }
    return { member: null };
  });

  return <PricingPage member={page.member} plans={plansOnSale()} />;
}

/** `/sign-in`. A member who is already signed in goes straight on. */
export function MemberSignIn() {
  const ready = $routed(async ({ request, query }) => {
    const plan = chosenPlan(query);
    if (await getMember(request)) return redirectRoute(afterSignIn(plan));
    return { plan };
  });

  return (
    <AuthSplit
      first="Welcome"
      second="back"
      lede="Forex, crypto and synthetics signals, checked before they reach you."
      title="Sign in"
      text="Use the email and password you signed up with.">
      <MemberHeader slot="header" member={null} />
      <MemberSignInForm plan={ready.plan} />
    </AuthSplit>
  );
}

/** `/sign-up`: a new member account, then checkout. */
export function MemberSignUp() {
  const ready = $routed(async ({ request, query }) => {
    const plan = chosenPlan(query);
    if (await getMember(request)) return redirectRoute(afterSignIn(plan));
    return { plan };
  });

  return (
    <AuthSplit
      first="Join"
      second="Triaxis"
      lede="One axis or all three. Every signal passes its checks before it reaches you."
      title="Create your account"
      text="Then pick a plan. Your signals open as soon as your payment is approved.">
      <MemberHeader slot="header" member={null} />
      <MemberSignUpForm plan={ready.plan} />
    </AuthSplit>
  );
}

/** `/signals`: the member's axes and the signals on the ones they hold. */
export function MemberApp() {
  const home = $routed(async ({ request }) => {
    const signedIn = await getMember(request);
    if (!signedIn) return redirectRoute('/sign-in');
    const access = accessFor(signedIn);
    return {
      member: signedIn.member,
      access,
      payments: listMemberPayments(signedIn.member.id),
      signals: signalsFor(access),
    };
  });

  return (
    <MemberShell member={home.member}>
      <MemberDashboard home={home} />
    </MemberShell>
  );
}

/** `/subscribe`: pick a plan, pay, and submit the reference. */
export function MemberSubscribe() {
  const page = $routed(async ({ request, query }) => {
    const plan = chosenPlan(query);
    const signedIn = await getMember(request);
    if (!signedIn) return redirectRoute(signInFor(plan));
    return {
      member: signedIn.member,
      plan,
      axis: chosenAxis(query),
      access: accessFor(signedIn),
      payments: listMemberPayments(signedIn.member.id),
      instructions: paymentInstructions(),
    };
  });

  return (
    <MemberShell member={page.member}>
      <SubscribePage plans={plansOnSale()} chosen={page.plan} chosenAxis={page.axis} access={page.access} instructions={page.instructions} payments={page.payments} />
    </MemberShell>
  );
}
