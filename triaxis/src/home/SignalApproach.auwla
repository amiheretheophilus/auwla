<style>
  .approach {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 1.25rem 3rem;
    padding: clamp(2rem, 5vw, 5rem) var(--gutter);
    border-top: 1px solid var(--rule);
    background: #f8f4ec;
  }

  .approach h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3.5vw, 3.5rem);
