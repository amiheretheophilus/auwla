import { SignalApproach } from './home/SignalApproach.auwla';
import { AnalystDesk, DeskSignIn } from './desk/DeskRoutes.auwla';

<style>
  body {
    margin: 0;
  }

  .site-page {
    --ink: #27211d;
    --muted-ink: #564e46;
    --paper: #f1ebe1;
    --rule: #c9bfb2;
    --accent: #a8271c;
    --gutter: clamp(1.2rem, 4.2vw, 4.25rem);

    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-synthesis: none;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3.65rem;
    gap: 1.25rem;
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--rule);
  }

  .site-header a {
    color: inherit;
    text-decoration: none;
  }

  .site-header a:hover {
    text-decoration: underline;
    text-underline-offset: .3em;
  }

  .site-header a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .wordmark {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .site-header nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.75rem);
    font-size: .875rem;
  }
</style>

function MarketHome() {
  return (
    <div class="site-page" id="top">
      <header class="site-header">
        <a class="wordmark" href="#top">"Triaxis"</a>
        <nav aria-label="Main navigation">
          <a href="#markets">"Markets"</a>
          <a href="#approach">"Approach"</a>
          <a href="/desk">"Desk"</a>
        </nav>
      </header>

      <main>
        <MarketHero />
        <MarketCoverage />
        <SignalApproach />
      </main>
    </div>
  );
}

export function App() {
  return (
    <>
